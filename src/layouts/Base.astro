---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { t, getLangFromUrl, switchLang, LINKS, VERSION } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  /** Pages that must not be indexed (404). Also drops canonical and hreflang. */
  noindex?: boolean;
  /** 2026-10-28: 'pacenote' gives the Pacenote pages their own brand layer: accent, favicon, title suffix, share image. */
  brand?: 'pacenote';
}
const lang = getLangFromUrl(Astro.url);
const { title, description, noindex = false, brand } = Astro.props;
const pn = brand === 'pacenote';
const site = Astro.site!;
const fullTitle = title
  ? (pn ? (title === 'Pacenote' ? (lang === 'uk' ? 'Pacenote · Ваш штурман на дзвінках' : 'Pacenote · Your co-driver on calls') : title.includes('Pacenote') ? title : `${title} · Pacenote`) : `${title} · PM Control Tower`)
  : t(lang, 'meta.title');
const rawDesc = description ?? t(lang, 'meta.description');
// Search engines show about 160 characters: keep whole sentences that fit.
function trimDesc(text: string, max = 165): string {
  if (text.length <= max) return text;
  let out = '';
  for (const sentence of text.match(/[^.!?]+[.!?]+/g) ?? [text]) {
    if ((out + sentence).trim().length > max) break;
    out += sentence;
  }
  return out.trim() || text.slice(0, max - 1).replace(/\s+\S*$/, '') + '…';
}
const desc = trimDesc(rawDesc);
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(pn ? (lang === 'uk' ? '/pacenote/og-uk.png' : '/pacenote/og-en.png') : (lang === 'uk' ? '/og-uk.png' : '/og.png'), site);
const ogAlt = pn ? (lang === 'uk' ? 'Pacenote: ваш штурман на дзвінках' : 'Pacenote: your co-driver on calls') : t(lang, 'meta.title');
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/uk/';

// Structured data: the site itself, and on the home page the software it describes.
const jsonLd = isHome
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'PM Control Tower',
        url: new URL(lang === 'uk' ? '/uk/' : '/', site).href,
        inLanguage: lang,
        description: desc,
      },
      {
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'PM Control Tower',
        applicationCategory: 'BusinessApplication',
        operatingSystem: 'macOS',
        softwareVersion: VERSION,
        license: 'https://opensource.org/licenses/MIT',
        isAccessibleForFree: true,
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
        description: desc,
        url: new URL(lang === 'uk' ? '/uk/' : '/', site).href,
        downloadUrl: LINKS.repo,
        sameAs: [LINKS.repo, LINKS.notion],
        inLanguage: ['en', 'uk'],
      },
    ]
  : null;
---
<!doctype html>
<html lang={lang} data-theme="dark" data-brand={brand}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noindex
      ? <meta name="robots" content="noindex, follow" />
      : <>
          <meta name="robots" content="index, follow, max-image-preview:large" />
          <link rel="canonical" href={canonical} />
          <link rel="alternate" hreflang="en" href={new URL(switchLang(Astro.url, 'en'), site)} />
          <link rel="alternate" hreflang="uk" href={new URL(switchLang(Astro.url, 'uk'), site)} />
          <link rel="alternate" hreflang="x-default" href={new URL(switchLang(Astro.url, 'en'), site)} />
        </>}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href={pn ? '/pacenote/favicon.svg' : '/favicon.svg'} type="image/svg+xml" />
    <link rel="icon" href={pn ? '/pacenote/favicon-32.png' : '/favicon-32.png'} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={pn ? '/pacenote/apple-touch-icon.png' : '/apple-touch-icon.png'} />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0E1014" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // Theme: dark by default; light only when the viewer switched to it (remembered in the browser).
      (function () {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light') t = 'dark';
        document.documentElement.dataset.theme = t;
        var m = document.querySelector('meta[name="theme-color"]');
        if (m) m.setAttribute('content', t === 'light' ? '#F6F5F1' : '#0E1014');
      })();
    </script>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={pn ? 'Pacenote' : 'PM Control Tower'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content={lang === 'uk' ? 'uk_UA' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'uk' ? 'en_US' : 'uk_UA'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
  </head>
  <body>
    <a class="skip" href="#main">{t(lang, 'skip')}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Analytics id="G-6X2RXXK7F0" lang={lang} />
  </body>
</html>
