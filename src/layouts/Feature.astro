---
import Base from './Base.astro';
import Arrow from '../components/Arrow.astro';
import GithubLogo from '../components/GithubLogo.astro';
import LiveTipsVisual from '../components/LiveTipsVisual.astro';
import Shot from '../components/Shot.astro';
import { t, path, neighbours, LINKS, type Lang } from '../i18n/ui';
import PN_VERSION from '../data/pacenote-version.json';

interface Props {
  lang: Lang;
  slug: string;
  title: string;
  lead: string;
  description?: string;
  facts?: { k: string; v: string }[];
  doc?: string;
  parent?: string;
  headings?: { depth: number; slug: string; text: string }[];
}
const { lang, slug, title, lead, description, facts = [], doc, parent, headings = [] } = Astro.props;
const docHref = doc ? (doc.startsWith('http') ? doc : LINKS.docs(lang, doc)) : '';
const docName = doc ? (doc.startsWith('http') ? doc.replace(/^https:\/\/github\.com\/bodco\//, '').replace('/blob/main/', '/') : `docs/${lang}/${doc}`) : '';
const toc = headings.filter((h) => h.depth === 2);
// 2026-10-30 (design review): the Pacenote landing has no side rail (it is a landing, not a manual), the compare
// page shows its sections as a row of chips above the content, the details page keeps a compact sticky rail.
const tocMode = slug === 'pacenote' ? 'none' : slug === 'pacenote-compare' ? 'chips' : slug.startsWith('pacenote-') ? 'compact' : 'rail';
const showToc = toc.length > 1 && tocMode !== 'none';
const solo = tocMode === 'none' || tocMode === 'chips';
const { prev, next } = neighbours(slug);
const product = slug === 'pacenote';     // 2026-10-27 (owner): a product hero (title, subtitle, buttons, a picture)
// 2026-10-28 (owner): Pacenote pages carry the Pacenote brand layer (blue accent, its own icon and favicon).
const brand = slug === 'pacenote' || slug.startsWith('pacenote-') ? 'pacenote' : undefined;
const P = lang === 'uk'
  ? { sub: 'Ваш штурман на дзвінках', mac: 'Завантажити для Мака', skill: 'Скіл для Cowork', note: `Безкоштовно, відкритий код · macOS 14.4+, Apple Silicon · версія ${PN_VERSION.version}` }
  : { sub: 'Your co-driver on calls', mac: 'Download for Mac', skill: 'Skill for Cowork', note: `Free and open source · macOS 14.4+, Apple Silicon · version ${PN_VERSION.version}` };
---
<Base title={title} description={description ?? lead} brand={brand}
  crumbParent={parent ? { name: t(lang, `nav.${parent}` as any), href: path(lang, parent) } : undefined}
  ld={product ? [{
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Pacenote',
    alternateName: lang === 'uk' ? 'Pacenote: штурман на дзвінках' : 'Pacenote: your co-driver on calls',
    applicationCategory: 'BusinessApplication',
    applicationSubCategory: 'Meeting assistant',
    operatingSystem: 'macOS 14.4 or later (Apple silicon)',
    softwareVersion: PN_VERSION.version,
    license: 'https://opensource.org/licenses/MIT',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: description ?? lead,
    url: new URL(path(lang, 'pacenote'), Astro.site).href,
    downloadUrl: 'https://github.com/bodco/live-tips/releases/latest/download/Pacenote.dmg',
    screenshot: new URL(`/pacenote/shots/${lang === 'uk' ? 'uk-' : ''}tips-wide-dark.webp`, Astro.site).href,
    sameAs: ['https://github.com/bodco/live-tips'],
    author: { '@type': 'Person', name: 'bodco', url: 'https://github.com/bodco' },
    inLanguage: ['en', 'uk'],
  }] : []}>
  {product ? (
  <section class="page-hero product-hero">
    <div class="wrap product-hero__in">
      <div class="product-hero__text">
        <p class="crumbs"><a href={path(lang)}>{t(lang, 'home')}</a> / {t(lang, `nav.${slug}` as any)}</p>
        <div class="product-hero__name"><img class="pn-theme--dark" src="/pacenote/icon-dark-128.png" alt="" width="64" height="64" /><img class="pn-theme--light" src="/pacenote/icon-light-128.png" alt="" width="64" height="64" /><h1 class="h1 h1--hero product-hero__wm"><span class="pn-sr">{title}</span><img class="pn-theme--dark" src="/pacenote/wordmark-white.svg" alt="" width="230" height="53" /><img class="pn-theme--light" src="/pacenote/wordmark-ink.svg" alt="" width="230" height="53" /></h1></div>
        <p class="product-hero__sub">{P.sub}</p>
        <p class="lead">{lead}</p>
        <div class="btns btns--one">
          <a class="btn btn--primary" href="https://github.com/bodco/live-tips/releases/latest/download/Pacenote.dmg" download>{P.mac} <Arrow /></a>
        </div>
        <p class="hero-alt">
          <a href="https://github.com/bodco/live-tips/releases/latest/download/live-tips.skill" download>{P.skill}</a>
          <a href="https://github.com/bodco/live-tips"><GithubLogo /> GitHub</a>
        </p>
        <p class="smallprint">{P.note}</p>
      </div>
      <div class="product-hero__vis"><Shot name={lang === 'uk' ? 'uk-tips-wide' : 'tips-wide'} width={1600} height={1034} eager alt={lang === 'uk' ? 'Вікно підказок Pacenote на дзвінку: одна відповідь великим шрифтом, раніші підказки рядками, транскрипт збоку' : 'The Pacenote tips window on a call: one answer in large type, earlier tips as single lines, the transcript on the side'} /></div>
    </div>
  </section>
  ) : (
  <section class="page-hero">
    <div class="page-hero__in wrap">
      <div class="page-hero__text">
        <p class="crumbs"><a href={path(lang)}>{t(lang, 'home')}</a> / {parent && <><a href={path(lang, parent as any)}>{t(lang, `nav.${parent}` as any)}</a> / </>}{t(lang, `nav.${slug}` as any)}</p>
        <h1 class="h1 h1--page">{title}</h1>
        <p class="lead">{lead}</p>
      </div>
      {facts.length > 0 && (
        <dl class="facts">
          {facts.map((f) => (<div><dt>{f.k}</dt><dd set:html={f.v} /></div>))}
        </dl>
      )}
    </div>
  </section>
  )}

  <div class:list={['page-body wrap', { 'page-body--solo': solo }]}>
    {showToc && (
      <details class:list={['toc', { 'toc--chips': tocMode === 'chips', 'toc--compact': tocMode === 'compact' }]} open>
        <summary class="label toc__sum">{t(lang, 'page.onthis')}</summary>
        <nav class="toc__links" aria-label={t(lang, 'page.onthis')}>
          {toc.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
        </nav>
      </details>
    )}
    {showToc && tocMode !== 'chips' && (
      <script is:inline>
        // Collapsed by default on narrow screens, so step 1 is not pushed a screen down. Runs before paint.
        (function () { var d = document.currentScript && document.currentScript.previousElementSibling; if (d && d.tagName === 'DETAILS' && window.matchMedia('(max-width: 700px)').matches) d.open = false; })();
      </script>
    )}
    <div class="page-main">
      <article class="prose"><slot /></article>

      {doc && (
        <aside class="docs-cta">
          <div><b>{t(lang, 'page.docs.title')}</b><span class="muted">{t(lang, 'page.docs.text')}</span></div>
          <a class="btn" href={docHref}>{t(lang, 'page.docs.btn')} <code>{docName}</code></a>
        </aside>
      )}

      <nav class="pager" aria-label="Pager">
        {prev ? <a href={path(lang, prev)}><span class="label">{t(lang, 'page.prev')}</span><b>{t(lang, `nav.${prev}` as any)}</b></a> : <span />}
        {next && <a class="next" href={path(lang, next)}><span class="label">{t(lang, 'page.next')}</span><b>{t(lang, `nav.${next}` as any)} <Arrow /></b></a>}
      </nav>
    </div>
  </div>
</Base>

<style>
  .product-hero__in { display: flex; flex-wrap: wrap; gap: 56px; align-items: center; padding-top: 72px; padding-bottom: 72px; }
  .product-hero__text { flex: 1 1 440px; display: flex; flex-direction: column; gap: 18px; min-width: 0; }
  .product-hero__vis { flex: 1 1 380px; min-width: 0; }
  .product-hero__name { display: flex; align-items: center; gap: 18px; }
  .product-hero__name img { border-radius: 14px; }
  .product-hero__name h1 { margin: 0; }
  .product-hero__wm img { width: 230px; height: auto; border-radius: 0; }
  @media (max-width: 720px) { .product-hero__wm img { width: 180px; } }
  .product-hero__sub { margin: 0; font-size: 24px; line-height: 1.3; color: var(--text); font-weight: 500; }
  @media (max-width: 720px) { .product-hero__in { padding-top: 40px; padding-bottom: 48px; gap: 36px; } .product-hero__sub { font-size: 20px; } }
</style>

<script>
  // Copy buttons on every code block, so nobody has to select text by hand.
  const copyLabel = document.documentElement.lang === 'uk' ? ['Копіювати', 'Скопійовано'] : ['Copy', 'Copied'];
  // Short prompts wrap on phones; shell commands and diagrams keep their lines and scroll sideways.
  const NOWRAP = /^\s*(\/bin\/|brew |xcode-select|git |curl |sudo |python|pip |npm |cd |\.\/|~\/)|[─│┐┘┤▶]/m;
  document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
    if (pre.closest('.codefig')) return; // illustrations, not prompts to copy
    if (NOWRAP.test(pre.textContent ?? '')) pre.classList.add('pre--nowrap');
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy';
    btn.textContent = copyLabel[0];
    btn.addEventListener('click', async () => {
      const text = pre.querySelector('code')?.innerText ?? pre.innerText;
      try { await navigator.clipboard.writeText(text.trim()); } catch { return; }
      btn.textContent = copyLabel[1];
      btn.dataset.done = 'true';
      setTimeout(() => { btn.textContent = copyLabel[0]; btn.dataset.done = 'false'; }, 1600);
    });
    const wrap = document.createElement('div');
    wrap.className = 'code-wrap';
    const bar = document.createElement('div');
    bar.className = 'code-wrap__bar';
    bar.appendChild(btn);
    pre.parentNode?.insertBefore(wrap, pre);
    wrap.appendChild(bar);
    wrap.appendChild(pre);
  });

  // Highlight the current section in the table of contents.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  if (links.length && 'IntersectionObserver' in window) {
    const map = new Map(links.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          links.forEach((a) => a.classList.remove('is-active'));
          map.get(e.target.id)?.classList.add('is-active');
        }
      }
    }, { rootMargin: '-90px 0px -70% 0px' });
    document.querySelectorAll('.prose h2[id]').forEach((h) => io.observe(h));
  }
</script>
