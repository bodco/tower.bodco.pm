    { k: 'Sales mode', h: 'Qualify while you talk.', l: ['BANT, SPICED or MEDDIC, tracked live on a Deal tab.', 'HubSpot snapshot before the call. Updates only on your click, with 8\u00a0s Undo.'] },
    { k: 'Presenting mode', h: 'Finish on time.', l: ['A timer per slide, and one quiet note when you run late.', 'Rehearse first, then face 4 tough client questions.'] },
  ],
  bant: [['BUDGET', 'known'], ['AUTHORITY', 'partly'], ['NEED', 'known'], ['TIMING', 'unknown']],
  toast: 'HubSpot updated on your click · Undo 8\u00a0s', illus: 'Deal tab, simplified', compact: 'The compact strip during a talk.',
  cH: 'Pay for calls, not seats.', cSub: 'The app is free. You pay your AI provider only for the calls you run.',
  opts: [
    { tag: 'Recommended', t: 'A plan you already pay for', big: '~$1.1', u: 'a month on top of your plan, 10 calls', d: 'Briefs and notes run on your Claude, ChatGPT or Gemini plan. Live tips need a separate API key, with a cap you set.' },
    { tag: 'Your own API key', t: 'Pay per call', big: '$7-13', u: 'a month, 10 calls', d: '$0.74 a call on OpenAI, $1.33 on Claude. Soft and hard limits per call, plus a monthly cap you set.' },
    { tag: 'Fully on your Mac', t: 'No API key at all', big: '$0', u: 'always', d: 'Transcript, recording, briefs and notes on your Mac, from a local model. Simpler cards from your files, no AI-written tips.' },
  ],
  calc: { title: 'Your month', calls: 'Calls a month', len: 'Call length', lens: ['15 min', '30 min', '60 min'], how: 'How you run the AI', plans: ['My existing plan', 'OpenAI API key', 'Claude API key', 'On my Mac'], out: 'Pacenote, AI cost a month', onTop: 'Pacenote (on top of your plan)', per: 'per call', seat: 'A recorder seat, any number of calls', yearly: 'yearly', monthly: 'monthly', free: 'Fathom also has a free plan.', cap: 'Your monthly cap in Settings stops paid calls when it is reached.', more: 'More than a recorder seat at this volume. You pay per call, not per idle month.', unit: (n: number) => `${n} call${n === 1 ? '' : 's'}` },
  table: { cap: 'AI cost a month, 30-minute calls', head: ['Calls a month', 'Existing plan', 'OpenAI API key', 'Claude API key', 'Recorder seat'], rows: [['4', 'under $1', '~$3', '~$5', '$10-20'], ['10', '~$1.1', '~$7', '~$13', '$10-20'], ['20', '~$2', '~$15', '~$27', '$10-20']] },
  cFoot: 'Pacenote costs measured on real and test calls, 22 October to 4 November 2026. Token prices as of 4 November 2026. Recorder prices as published 28 October 2026. Prices change; the app shows what each call really cost.',
  cLink: 'Full cost table',
  qH: 'Before you install',
  faq: [
    ['How fast is a tip, and is it right?', 'Fact cards from your prep show in 1-2\u00a0s, or nothing shows at all. In this beta, your tip ratings and corrections shape later calls.'],
    ['How much setup before it is useful?', 'A calendar invite and one doc or folder are enough to start. The Setup window downloads about 2.5 GB and needs no admin password.'],
    ['Is it $0, or do I need an API key?', 'On your plan, tips need a small API key: about $1 a month. Fully on your Mac, with simpler cards, it costs $0.'],
    ['Can I trust an unsigned beta?', 'It is not notarized yet, so first launch needs Open Anyway in Privacy & Security. The code is open (MIT), and you can check the download’s SHA-256.'],
    ['What does it do with my Google account?', 'Google is optional and read-only, except the Doc you export. Calendars also work through macOS; sign-in warns "unverified app" while Google reviews the app.'],
    ['Where does my call text go?', 'Audio stays on your Mac, and only text reaches the AI provider you pick, under your own account or API terms. The author gets nothing unless you switch on usage counts.'],
    ['What do I tell people on the call?', 'Tell them you keep a transcript and use an AI assistant. Get consent where the law or your employer requires it.'],
    ['Do I have to drop my note taker?', 'You may not need it: transcript, recording and notes are in Pacenote too, free on your Mac. Keep it if your team shares recordings there.'],
    ['Which call apps and Macs does it work with?', 'Any call app on your Mac, such as Zoom, Meet, Teams or Slack. It listens to the Mac’s sound and needs Apple Silicon with macOS 14.4+.'],
  ],
  faqLinks: [['Google user data', `${B}/privacy/#google-user-data`], ['Privacy', `${B}/privacy/`], ['Pacenote vs Fireflies and Fathom', `${B}/compare/`]],
  end: { h: 'Try it on your next call.', hB: 'Try it next Tuesday.', sub: 'Transcript, recording and notes like your note taker, plus help while you talk.', btn: 'Download for Mac', under: 'Free beta · Apple Silicon, macOS 14.4+', first: 'First launch: Open Anyway in System Settings > Privacy & Security.', it: 'For IT: not notarized yet, no admin password needed. Open source (MIT), SHA-256 to verify. Nothing is sent to the author unless you switch on usage counts.', skill: 'Work in Claude Cowork? Get the skill with the same tips.', docs: 'Documentation', news: 'What’s new' },
  day: {
    eyebrow: 'A day with Pacenote', h: 'Tuesday. Five calls, back to back.', sub: 'One ordinary day of calls, and what Pacenote shows at each one.', prev: 'Previous', next: 'Next',
    stops: [
      ['8:55', 'Next call in 5 minutes.', 'Home shows the next call from every calendar and whether its brief is ready.', 'home-092', 1600, 1109],
      ['9:00', 'Emily asks. The answer is already there.', 'One card under your camera: the fact, its source and a sentence to say.', 'tips-wide', 1600, 1034],
      ['11:00', 'Rehearsed at 10:30. On time at 11:00.', 'Rehearsal asked 4 tough questions. Now a timer per slide keeps you on plan.', 'tips-compact', 1120, 364],
      ['14:00', 'BANT on the side, eyes on the buyer.', 'The Deal tab tracks each criterion live. HubSpot changes only on your click.', 'live-092', 1600, 1046],
      ['17:30', 'Everything you promised today, in one place.', 'A page for every call, and a Tracker of tasks, decisions and risks across projects.', 'callpage-095', 1600, 1311],
    ],
  },
