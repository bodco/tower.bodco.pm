  ph: [
    { k: '8:55 · Before the call', h: 'Walk in with the facts.', l: 'A brief from your project files, Notion, Google Docs and earlier calls. Home shows the next call and whether its brief is ready.', img: 'home-092', W: 1600, H: 1109, x: 96, y: 140, w: 560, hh: 653, alt: 'Pacenote Home: the next call and its readiness' },
    { k: '9:00 · During the call', h: 'Eyes on the client, answer under the camera.', l: 'HELP NOW (Control-Option-H) for a new question. Recording is optional and stays on your Mac; tell people you keep a transcript.', img: 'tips', W: 880, H: 1584, x: 0, y: 0, w: 880, hh: 1027, alt: 'The Pacenote tips window with an answer', small: 'Hidden from screen sharing, checked in Google Meet. Check your call app once.' },
    { k: '9:31 · After the call', h: 'Notes you did not have to write.', l: 'Decisions, what is on you and on them, risks. A follow-up draft in the call’s language, exported to Notion, Google Docs or Word.', img: 'callpage-095', W: 1600, H: 1311, x: 1010, y: 372, w: 460, hh: 537, alt: 'The Pacenote call page: for the next call and the agenda' },
  ],
  phH: 'From the invite to the follow-up.', phL: 'One call', moH: 'Sales calls and talks, too.', moL: 'Modes',
  lH: 'Your calls, your language.', lSub: 'For calls in a language that is not your first.',
  lList: ['Set the call’s languages in advance. That is more accurate than auto-detect.', 'The ready phrase comes in the language of the call.', 'The follow-up draft is written in the call’s language too.', 'Mixed-language call? Keep the transcript in one language, if you choose.'],
  lClose: 'Your English, with the sentence ready.',
  lCard1: { k: 'ANSWER', q: 'when is the pilot?', a: 'The pilot starts on November 10 with five users.' },
