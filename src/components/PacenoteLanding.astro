  baseH: 'What recorders do', baseList: [['Transcript with speakers', '$0 on your Mac'], ['Sound or screen recording', '$0 on your Mac'], ['Summary, decisions, action items', 'local $0, or your AI'], ['Follow-up draft in the call\u2019s language', ''], ['Search across past calls', ''], ['Export to Notion, Google Docs, Word, Markdown', ''], ['HubSpot, only on your click', ''], ['Google Meet participants and transcript', '']],
  onlyH: 'Only in Pacenote', onlyList: ['A brief from your files, Notion and earlier calls', 'The answer under your camera in 1-2\u00a0s', 'HELP NOW and questions mid-call', 'A live agenda, ticked as you go', 'A timer per slide and a rehearsal', 'BANT, SPICED, MEDDIC, live'],
