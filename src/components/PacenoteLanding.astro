// The scripted call, the same for both languages (a call with an American client).
const RP_WITHOUT = [
  { at: 0, who: 'Emily', cl: true, t: 'When is the export live for our users?' },
  { at: 1300, who: T.rp.you, t: 'Good question. It is close, I think...' },
  { at: 2600, who: 'David', cl: true, t: 'Close as in this week? Our finance team is waiting.' },
  { at: 3800, who: T.rp.you, t: 'Let me get back to you on that.', bad: true },
];
const RP_WITH = [
  { at: 0, who: 'Emily', cl: true, t: 'When is the export live for our users?' },
  { at: 2300, who: T.rp.you, t: 'It is on dev now. Production on Tuesday, after the review.', good: true },
  { at: 3300, who: 'David', cl: true, t: 'Good. And who tests the pilot?' },
];
const SEAT_MAX = 24;
---
<script is:inline>if ('IntersectionObserver' in window) document.documentElement.classList.add('pnl-js');</script>
<div class="pnl" data-pnl>

  <section class="pnl-trust" aria-label={uk ? 'Коротко' : 'In short'}>
    <div class="wrap"><ul>{T.trust.map((f) => <li>{f}</li>)}</ul></div>
  </section>

  {variant === 'a' ? (
  <!-- A. The three seconds: a without / with replay -->
  <section class="pnl-sec pnl-sec--sig" id="moment" data-section="moment">
    <div class="wrap">
      <div class="pnl-head pnl-rv">
        <p class="pnl-label">{T.rp.eyebrow}</p>
        <h2 class="pnl-h2" id="the-three-seconds">{T.rp.h}</h2>
        <p class="pnl-lead">{T.rp.sub}</p>
      </div>
      <div class="pnl-rp" data-rp>
        <div class="pnl-rp__bar" data-rp-bar hidden>
          <div class="pnl-seg" role="group" aria-label={T.rp.eyebrow}>
            <button type="button" class="pnl-seg__opt" data-rp-mode="without" aria-pressed="false">{T.rp.without}</button>
            <button type="button" class="pnl-seg__opt" data-rp-mode="with" aria-pressed="true">{T.rp.with}</button>
            <span class="pnl-seg__pill" aria-hidden="true"></span>
          </div>
          <button type="button" class="pnl-rp__replay" data-rp-replay><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8a5 5 0 1 0 1.5-3.6M3 2.5v2.4h2.4" /></svg>{T.rp.replay}</button>
        </div>
        <p class="pn-sr">{T.rp.alt}</p>
        <div class="pnl-rp__stages" aria-hidden="true">
          {(['without', 'with'] as const).map((k) => {
            const lines = k === 'without' ? RP_WITHOUT : RP_WITH;
            return (
            <div class={`pnl-rp__stage pnl-rp__stage--${k}`} data-rp-stage={k}>
              <p class="pnl-rp__name">{k === 'without' ? T.rp.without : T.rp.with}</p>
              <div class="pnl-rp__grid">
                <div class="pnl-rp__call">
                  <div class="pnl-rp__cam"><span class="pnl-rp__avatar">E</span><span class="pnl-rp__avatar pnl-rp__avatar--d">D</span><span class="pnl-rp__live">12:04</span></div>
                  {lines.map((l) => <p class:list={['pnl-rp__line', { 'is-cl': l.cl, 'is-bad': (l as any).bad, 'is-good': (l as any).good }]} data-at={l.at}><b>{l.who}</b><span>{l.t}</span></p>)}
                  {k === 'without' && <p class="pnl-rp__note" data-at="4400">{T.rp.note}</p>}
                </div>
                <div class:list={['pnl-rp__win', { 'pnl-rp__win--tabs': k === 'without' }]}>
                  {k === 'without'
                    ? <div class="pnl-mini__bar"><span class="pnl-mini__dots"><i></i><i></i><i></i></span><span>{T.rp.files}</span></div>
                    : <div class="pnl-mini__bar"><span class="pnl-mini__dots"><i></i><i></i><i></i></span><span>Pacenote · Orbit weekly</span><span class="pnl-mini__rec"></span></div>}
                  {k === 'without'
                    ? <div class="pnl-mini__body pnl-mini__body--tabs"><p class="pnl-tabrow" data-at="900"><b>notes.md</b><span>kickoff, Oct 28</span></p><p class="pnl-tabrow" data-at="1700"><b>Slack #orbit</b><span>412 messages</span></p><p class="pnl-tabrow" data-at="2500"><b>Drive: release plan</b><span>v3, 14 pages</span></p></div>
                    : <div class="pnl-mini__body">
                        <div class="pnl-ans" data-at="1400">
                          <p class="pnl-ans__tag">{T.rp.lab.ans} <span>{T.rp.lab.now}</span></p>
                          <p class="pnl-ans__q">when is the export live?</p>
                          <p class="pnl-ans__a">It is on dev now, production on Tuesday after the review.</p>
                          <p class="pnl-ans__src">{T.rp.lab.docs} · kickoff-notes.md</p>
                        </div>
                      </div>}
                </div>
              </div>
              <div class="pnl-ruler" data-ruler>
                <div class="pnl-ruler__track"><span class="pnl-ruler__fill" data-fill={k === 'without' ? '100' : '46.7'}></span>{k === 'with' && <span class="pnl-ruler__mark" data-at="1400" style="left: 46.7%">{T.rp.card} · {uk ? '1,4' : '1.4'}{'\u00a0'}{T.rp.sec}</span>}</div>
                <div class="pnl-ruler__ticks">{[0, 1, 2, 3].map((n) => <span>{n}{'\u00a0'}{T.rp.sec}</span>)}</div>
              </div>
              <p class="pnl-rp__verdict" data-at={k === 'without' ? '4400' : '1400'}>{k === 'without' ? T.rp.vNo : T.rp.vYes}</p>
            </div>
          ); })}
        </div>
        <p class="pnl-small">{T.rp.caption}</p>
      </div>
      <p class="pnl-rp__quick pnl-rv">{T.rp.quick}</p>
      <div class="pnl-ctarow pnl-rv">
        <a class="btn btn--primary" href={DMG} download>{T.rp.cta}</a>
        <span class="pnl-ctarow__under">{T.rp.under}</span>
        <a class="pnl-link" href={`${B}/details/#when-it-speaks`}>{T.rp.how} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
  ) : (
  <!-- B. Tuesday: a day of five calls -->
  <section class="pnl-sec pnl-sec--sig" id="tuesday" data-section="tuesday">
    <div class="wrap">
      <div class="pnl-head pnl-rv">
        <p class="pnl-label">{T.day.eyebrow}</p>
        <h2 class="pnl-h2" id="tuesday-h">{T.day.h}</h2>
        <p class="pnl-lead">{T.day.sub}</p>
      </div>
      <div class="pnl-day" data-day>
        <nav class="pnl-day__rail" aria-label={T.day.eyebrow}>
          {T.day.stops.map((s, i) => <a class:list={['pnl-day__chip', { 'is-on': i === 0 }]} href={`#day-${i}`} data-i={i}>{s[0]}</a>)}
          <span class="pnl-day__nav"><button type="button" data-day-prev aria-label={T.day.prev} hidden>‹</button><button type="button" data-day-next aria-label={T.day.next} hidden>›</button></span>
        </nav>
        <ol class="pnl-day__track" data-day-track tabindex="0">
          {T.day.stops.map((s, i) => (
            <li class="pnl-day__stop" id={`day-${i}`} data-i={i}>
              <figure class={`pnl-day__shot pnl-day__shot--${s[3]}`}><img class="ltshot--dark" src={`${SH(s[3] as string)}-dark.webp`} alt={s[1] as string} width={s[4] as number} height={s[5] as number} loading="lazy" decoding="async" /><img class="ltshot--light" src={`${SH(s[3] as string)}-light.webp`} alt={s[1] as string} width={s[4] as number} height={s[5] as number} loading="lazy" decoding="async" /></figure>
              <div class="pnl-day__cap"><p class="pnl-day__time">{s[0]}</p><h3>{s[1]}</h3><p>{s[2]}</p></div>
            </li>
          ))}
        </ol>
      </div>
      <div class="pnl-ctarow pnl-rv">
        <a class="btn btn--primary" href={DMG} download>{T.rp.cta}</a>
        <span class="pnl-ctarow__under">{T.rp.under}</span>
      </div>
    </div>
  </section>
  )}

  <!-- One line of fact, or nothing -->
  <section class="pnl-sec" id="facts" data-section="facts">
    <div class="wrap">
      <div class="pnl-head pnl-rv"><h2 class="pnl-h2" id="one-line-of-fact">{T.fH}</h2><p class="pnl-lead">{T.fSub}</p></div>
      <div class="pnl-tips">
        {T.tips.map((t) => <div class="pnl-tip pnl-rv"><p class={`pnl-tip__k pnl-tip__k--${t.c}`}><i></i>{t.k}</p><p class="pnl-tip__t">{t.t}</p>{t.p && <p class="pnl-tip__p">{t.p}</p>}{(t as any).s && <p class="pnl-tip__s">{(t as any).s}</p>}</div>)}
        <div class="pnl-tip pnl-tip--empty pnl-rv"><p class="pnl-tip__k"><span class="pnl-wait"><i></i><i></i><i></i></span>{T.empty.k}</p><p class="pnl-tip__t">{T.empty.t}</p><p class="pnl-tip__s">{T.empty.s}</p></div>
      </div>
      <p class="pnl-small pnl-rv">{T.fFoot}</p>
    </div>
  </section>

  {variant === 'a' && (
  <!-- Before / during / after: three columns with detail crops -->
  <section class="pnl-sec" id="phases" data-section="phases">
    <div class="wrap">
      <div class="pnl-head pnl-rv"><p class="pnl-label">{T.phL}</p><h2 class="pnl-h2" id="before-during-after">{T.phH}</h2></div>
      <div class="pnl-phases">
        {T.ph.map((p) => (
          <article class="pnl-phase pnl-rv">
            <div class="pnl-crop" style={`aspect-ratio: ${p.w} / ${p.hh}`} role="img" aria-label={p.alt}>
              {['dark', 'light'].map((th) => <img class={`ltshot--${th}`} src={`${SH(p.img)}-${th}.webp`} alt="" width={p.W} height={p.H} loading="lazy" decoding="async" style={`width: ${(p.W / p.w * 100).toFixed(3)}%; left: ${(-p.x / p.w * 100).toFixed(3)}%; top: ${(-p.y / p.hh * 100).toFixed(3)}%`} />)}
            </div>
            <p class="pnl-label">{p.k}</p>
            <h3 class="pnl-h3">{p.h}</h3>
            <p class="pnl-body">{p.l}</p>
            {(p as any).small && <p class="pnl-small">{(p as any).small}</p>}
          </article>
        ))}
      </div>
    </div>
  </section>
  )}

  <!-- Everything a note taker does, plus the call itself -->
  <section class="pnl-sec" id="switch" data-section="switch">
    <div class="wrap">
      <div class="pnl-head pnl-rv"><h2 class="pnl-h2" id="everything-your-note-taker-does">{T.sH}</h2><p class="pnl-lead">{T.sSub}</p></div>
      <div class="pnl-parity pnl-rv">
        <div class="pnl-parity__col"><p class="pnl-label">{T.baseH}</p><ul>{T.baseList.map(([a, b]) => <li><span>{a}</span>{b && <em>{b}</em>}</li>)}</ul></div>
        <div class="pnl-parity__col pnl-parity__col--only"><p class="pnl-label">{T.onlyH}</p><ul>{T.onlyList.map((a) => <li><span>{a}</span></li>)}</ul></div>
      </div>
      <div class="pnl-switch pnl-rv" data-switch>
        <p class="pnl-switch__lbl pnl-label">{T.swH}</p>
        <div class="pnl-switch__tabs" role="tablist" aria-label={T.swH} hidden data-switch-tabs>
          {T.sw.map(([n], i) => <button type="button" role="tab" id={`sw-t${i}`} aria-controls={`sw-p${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{n}</button>)}
        </div>
        <div class="pnl-switch__panels">
          {T.sw.map(([n, t], i) => <div class="pnl-switch__panel" role="tabpanel" id={`sw-p${i}`} aria-labelledby={`sw-t${i}`}><h3 class="pnl-switch__h">{n}</h3><p>{t}</p></div>)}
        </div>
      </div>
    </div>
  </section>

  {variant === 'a' && (
  <!-- Your calls, your language -->
  <section class="pnl-sec" id="language" data-section="language">
    <div class="wrap pnl-lang">
      <div class="pnl-lang__text pnl-rv">
        <h2 class="pnl-h2" id="your-language">{T.lH}</h2>
        <p class="pnl-lead">{T.lSub}</p>
        <ul class="pnl-dots">{T.lList.map((x) => <li>{x}</li>)}</ul>
        <p class="pnl-lang__close">{T.lClose}</p>
      </div>
      <div class="pnl-lang__cards pnl-rv" aria-hidden="true">
        <div class="pnl-ans pnl-ans--solo"><p class="pnl-ans__tag">{T.lCard1.k} <span>{T.rp.lab.now}</span></p><p class="pnl-ans__q">{T.lCard1.q}</p><p class="pnl-ans__a">{T.lCard1.a}</p></div>
        <div class="pnl-draft"><p class="pnl-draft__k">{T.lCard2.k}</p>{T.lCard2.lines.map((x) => <p>{x}</p>)}</div>
      </div>
    </div>
  </section>

  <!-- Sales and presenting -->
  <section class="pnl-sec" id="modes" data-section="modes">
    <div class="wrap">
    <div class="pnl-head pnl-rv"><p class="pnl-label">{T.moL}</p><h2 class="pnl-h2" id="sales-and-talks">{T.moH}</h2></div>
    <div class="pnl-modes">
      <article class="pnl-mode pnl-rv">
        <div class="pnl-mode__vis pnl-mode__vis--sales" aria-hidden="true">
          <ul class="pnl-bant">{T.bant.map(([k, v], i) => <li class={`is-${['known', 'part', 'known', 'no'][i]}`}><b>{k}</b><span>{v}</span></li>)}</ul>
          <p class="pnl-toast"><i></i>{T.toast}</p>
          <p class="pnl-mode__illus">{T.illus}</p>
        </div>
        <p class="pnl-label">{T.modes[0].k}</p><h3 class="pnl-h3">{T.modes[0].h}</h3>{T.modes[0].l.map((x) => <p class="pnl-body">{x}</p>)}
      </article>
      <article class="pnl-mode pnl-rv">
        <div class="pnl-mode__vis pnl-mode__vis--present">
          <figure class="ltshot"><img class="ltshot__img ltshot--dark" src={`${SH('tips-compact')}-dark.webp`} alt={T.compact} width="1120" height="364" loading="lazy" decoding="async" /><img class="ltshot__img ltshot--light" src={`${SH('tips-compact')}-light.webp`} alt={T.compact} width="1120" height="364" loading="lazy" decoding="async" /><figcaption>{T.compact}</figcaption></figure>
        </div>
        <p class="pnl-label">{T.modes[1].k}</p><h3 class="pnl-h3">{T.modes[1].h}</h3>{T.modes[1].l.map((x) => <p class="pnl-body">{x}</p>)}
      </article>
    </div>
    </div>
  </section>
  )}

  <!-- Cost -->
  <section class="pnl-sec" id="cost" data-section="cost">
    <div class="wrap">
      <div class="pnl-head pnl-rv"><h2 class="pnl-h2" id="pay-for-calls">{T.cH}</h2><p class="pnl-lead">{T.cSub}</p></div>
      <div class="pnl-opts">
        {T.opts.map((o, i) => <div class:list={['pnl-opt pnl-rv', { 'is-rec': i === 0 }]}><p class="pnl-label">{o.tag}</p><h3 class="pnl-opt__t">{o.t}</h3><p class="pnl-opt__big">{o.big}<span>{o.u}</span></p><p class="pnl-body">{o.d}</p></div>)}
      </div>
      <div class="pnl-calc pnl-rv" data-calc data-rates={JSON.stringify(RATES)} data-unit={uk ? 'uk' : 'en'}>
        <div class="pnl-calc__in" data-calc-ui hidden>
          <p class="pnl-calc__title">{T.calc.title}</p>
          <label class="pnl-calc__f"><span>{T.calc.calls} <output data-calc-n>{T.calc.unit(10)}</output></span><input type="range" min="1" max="40" step="1" value="10" data-calc-calls /></label>
          <fieldset class="pnl-calc__f"><legend>{T.calc.len}</legend><div class="pnl-seg pnl-seg--sm">{T.calc.lens.map((l, i) => <label><input type="radio" name="pnl-len" value={i} checked={i === 1} /><span>{l}</span></label>)}</div></fieldset>
          <fieldset class="pnl-calc__f"><legend>{T.calc.how}</legend><div class="pnl-calc__plans">{T.calc.plans.map((l, i) => <label><input type="radio" name="pnl-plan" value={['plan', 'openai', 'claude', 'local'][i]} checked={i === 0} /><span>{l}</span></label>)}</div></fieldset>
        </div>
        <div class="pnl-calc__out" data-calc-ui hidden>
          <p class="pnl-calc__lbl">{T.calc.out}</p>
          <p class="pnl-calc__big" aria-live="polite"><output data-calc-total>~$1.1</output> <span data-calc-per>~$0.1 {T.calc.per}</span></p>
          <div class="pnl-bars" data-max={SEAT_MAX}>
            <div class="pnl-bar pnl-bar--pn"><span class="pnl-bar__n" data-calc-name data-a="Pacenote" data-b={T.calc.onTop}>{T.calc.onTop}</span><span class="pnl-bar__t"><i data-calc-bar style="width: 2%"></i></span><span class="pnl-bar__v" data-calc-v>~$1.1</span></div>
            {SEATS.map(([n, y, m]) => <div class="pnl-bar"><span class="pnl-bar__n">{n}</span><span class="pnl-bar__t"><i style={`width: ${(y / SEAT_MAX * 100).toFixed(1)}%`}></i><i class="is-m" style={`width: ${((m - y) / SEAT_MAX * 100).toFixed(1)}%`}></i></span><span class="pnl-bar__v">${y}-{m}</span></div>)}
          </div>
          <p class="pnl-bars__key"><span><i></i>{T.calc.yearly}</span><span><i class="is-m"></i>{T.calc.monthly}</span></p>
          <p class="pnl-small">{T.calc.seat}. {T.calc.free}</p>
          <p class="pnl-calc__more" data-calc-more hidden>{T.calc.more}</p>
          <p class="pnl-small">{T.calc.cap}</p>
        </div>
        <table class="pnl-calc__table" data-calc-table>
          <caption>{T.table.cap}</caption>
          <thead><tr>{T.table.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{T.table.rows.map((r) => <tr>{r.map((c, i) => i === 0 ? <th scope="row">{c}</th> : <td>{c}</td>)}</tr>)}</tbody>
        </table>
      </div>
      <p class="pnl-small pnl-foot">{T.cFoot} <a href={`${B}/pricing/`}>{T.cLink}</a></p>
      <div class="pnl-ctarow pnl-rv">
        <a class="btn btn--primary" href={DMG} download>{T.rp.cta}</a>
        <span class="pnl-ctarow__under">{T.rp.under}</span>
      </div>
    </div>
  </section>

  <!-- Before you install -->
  <section class="pnl-sec" id="faq" data-section="faq">
    <div class="wrap pnl-faq">
      <div class="pnl-faq__head pnl-rv"><h2 class="pnl-h2" id="before-you-install">{T.qH}</h2><p class="pnl-faq__links">{T.faqLinks.map(([n, h]) => <a href={h}>{n}</a>)}</p></div>
      <div class="pnl-faq__list pnl-rv">
        {T.faq.map(([q, a]) => <details class="pnl-faq__item"><summary>{q}<i aria-hidden="true"></i></summary><p>{a}</p></details>)}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="pnl-sec pnl-end" id="get" data-section="get">
    <div class="wrap">
      <div class="pnl-end__in pnl-rv">
        <div>
          <h2 class="pnl-h2" id="try-it">{variant === 'a' ? T.end.h : T.end.hB}</h2>
          <p class="pnl-lead">{T.end.sub}</p>
        </div>
        <div class="pnl-end__act">
          <a class="btn btn--primary pnl-btn-lg" href={DMG} download>{T.end.btn}</a>
          <p class="pnl-ctarow__under">{T.end.under}</p>
          <p class="pnl-small">{T.end.first} <a href={`${REPO}/releases/latest/download/SHA256SUMS.txt`}>SHA-256</a></p>
          <p class="pnl-small">{T.end.it}</p>
        </div>
      </div>
      <p class="pnl-end__links"><a href={SKILL} download>{T.end.skill}</a><a href={uk ? `${REPO}/blob/main/docs/uk/live-tips.md` : `${REPO}/blob/main/docs/en/live-tips.md`}>{T.end.docs}</a><a href={`${REPO}/blob/main/CHANGELOG.md`}>{T.end.news}</a></p>
    </div>
  </section>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-pnl]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const uk = document.documentElement.lang === 'uk';
  if (root && 'IntersectionObserver' in window) {
    if (!reduce) {
      root.classList.add('pnl-anim');
      const io = new IntersectionObserver((es) => {
        for (const e of es) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
      }, { rootMargin: '0px 0px -8% 0px' });
      root.querySelectorAll('.pnl-rv').forEach((el) => io.observe(el));
    }

    // Replay: plays "without", then "with", once; the toggle and Replay are in the visitor's hands.
    const rp = root.querySelector<HTMLElement>('[data-rp]');
    if (rp) {
      const bar = rp.querySelector<HTMLElement>('[data-rp-bar]')!;
      const opts = [...rp.querySelectorAll<HTMLButtonElement>('[data-rp-mode]')];
      const stages = Object.fromEntries([...rp.querySelectorAll<HTMLElement>('[data-rp-stage]')].map((s) => [s.dataset.rpStage, s]));
      let timers: number[] = [];
      let mode = 'with';
      const clear = () => { timers.forEach((t) => clearTimeout(t)); timers = []; };
      const show = (m: string) => {
        mode = m; rp.dataset.mode = m;
        opts.forEach((o) => o.setAttribute('aria-pressed', String(o.dataset.rpMode === m)));
      };
      const finish = (s: HTMLElement) => {
        s.querySelectorAll('[data-at]').forEach((el) => el.classList.add('on'));
        s.querySelectorAll<HTMLElement>('[data-fill]').forEach((f) => { f.style.transition = 'none'; f.style.width = `${f.dataset.fill}%`; });
      };
      const play = (m: string, then?: () => void) => {
        clear(); show(m);
        const s = stages[m]; if (!s) return;
        if (reduce) { finish(s); then?.(); return; }
        s.querySelectorAll('[data-at]').forEach((el) => el.classList.remove('on'));
        const fill = s.querySelector<HTMLElement>('[data-fill]');
        const dur = m === 'without' ? 3000 : 1400;
        if (fill) { fill.style.transition = 'none'; fill.style.width = '0%'; void fill.offsetWidth; fill.style.transition = `width ${dur}ms linear`; timers.push(window.setTimeout(() => { fill.style.width = `${fill.dataset.fill}%`; }, 300)); }
        let last = 0;
        s.querySelectorAll<HTMLElement>('[data-at]').forEach((el) => { const at = Number(el.dataset.at); last = Math.max(last, at); timers.push(window.setTimeout(() => el.classList.add('on'), at + 200)); });
        if (then) timers.push(window.setTimeout(then, last + 1400));
      };
      rp.classList.add('is-js');
      bar.hidden = false;
      Object.values(stages).forEach((s) => finish(s as HTMLElement));
      show('with');
      opts.forEach((o) => o.addEventListener('click', () => play(o.dataset.rpMode!)));
      rp.querySelector('[data-rp-replay]')?.addEventListener('click', () => play(mode));
      if (!reduce) {
        const vo = new IntersectionObserver((es) => {
          if (!es[0].isIntersecting) return;
          vo.disconnect();
          play('without', () => play('with'));
        }, { threshold: 0.4 });
        vo.observe(rp.querySelector('.pnl-rp__stages')!);
      }
    }

    // Switching tabs (ARIA tabs with arrow keys); without script all panels are listed.
    const sw = root.querySelector<HTMLElement>('[data-switch]');
    if (sw) {
      const tabs = [...sw.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const panels = [...sw.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
      const sel = (i: number, focus = false) => {
        tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(i === j)); t.tabIndex = i === j ? 0 : -1; });
        panels.forEach((p, j) => { p.hidden = i !== j; });
        if (focus) tabs[i].focus();
      };
      sw.classList.add('is-js');
      (sw.querySelector('[data-switch-tabs]') as HTMLElement).hidden = false;
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => sel(i));
        t.addEventListener('keydown', (e) => {
          const k = (e as KeyboardEvent).key;
          if (k === 'ArrowRight' || k === 'ArrowLeft') { e.preventDefault(); sel((i + (k === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length, true); }
        });
      });
      sel(0);
    }

    // Cost calculator.
    const calc = root.querySelector<HTMLElement>('[data-calc]');
    if (calc) {
      const rates = JSON.parse(calc.dataset.rates || '{}') as Record<string, number[]>;
      const max = Number(calc.querySelector<HTMLElement>('.pnl-bars')?.dataset.max || 60);
      const range = calc.querySelector<HTMLInputElement>('[data-calc-calls]')!;
      const nOut = calc.querySelector<HTMLElement>('[data-calc-n]')!;
      const tot = calc.querySelector<HTMLElement>('[data-calc-total]')!;
      const per = calc.querySelector<HTMLElement>('[data-calc-per]')!;
      const barEl = calc.querySelector<HTMLElement>('[data-calc-bar]')!;
      const v = calc.querySelector<HTMLElement>('[data-calc-v]')!;
      const more = calc.querySelector<HTMLElement>('[data-calc-more]')!;
      const money = (x: number) => x === 0 ? '$0' : x < 2 ? `~$${x.toFixed(1)}` : `~$${Math.round(x)}`;
      const money2 = (x: number) => x === 0 ? '$0' : `~$${x.toFixed(2)}`;
      const unit = (n: number) => uk
        ? `${n} ${n % 10 === 1 && n % 100 !== 11 ? 'дзвінок' : [2, 3, 4].includes(n % 10) && ![12, 13, 14].includes(n % 100) ? 'дзвінки' : 'дзвінків'}`
        : `${n} call${n === 1 ? '' : 's'}`;
      const perWord = uk ? 'за дзвінок' : 'per call';
      const upd = () => {
        const n = Number(range.value);
        const len = Number((calc.querySelector('input[name="pnl-len"]:checked') as HTMLInputElement)?.value ?? 1);
        const plan = (calc.querySelector('input[name="pnl-plan"]:checked') as HTMLInputElement)?.value ?? 'plan';
        const r = rates[plan]?.[len] ?? 0;
        const total = n * r;
        nOut.textContent = unit(n);
        tot.textContent = money(total);
        v.textContent = money(total);
        per.textContent = `${money2(r)} ${perWord}`;
        barEl.style.width = `${Math.max(total > 0 ? 1.5 : 0.6, Math.min(100, total / max * 100))}%`;
        more.hidden = !(total > 10);
        const nm = calc.querySelector<HTMLElement>('[data-calc-name]');
        if (nm) nm.textContent = plan === 'plan' ? (nm.dataset.b ?? '') : (nm.dataset.a ?? '');
        range.style.setProperty('--p', `${((n - 1) / 39) * 100}%`);
      };
      calc.classList.add('is-js');
      calc.querySelectorAll<HTMLElement>('[data-calc-ui]').forEach((el) => { el.hidden = false; });
      calc.querySelectorAll('input').forEach((i) => i.addEventListener('input', upd));
      upd();
    }

    // Tuesday: the chip of the stop in view; prev / next buttons.
    const day = root.querySelector<HTMLElement>('[data-day]');
    if (day) {
      const track = day.querySelector<HTMLElement>('[data-day-track]')!;
      const stops = [...day.querySelectorAll<HTMLElement>('.pnl-day__stop')];
      const chips = [...day.querySelectorAll<HTMLElement>('.pnl-day__chip')];
      let cur = 0;
      const go = (i: number) => { const s = stops[Math.max(0, Math.min(stops.length - 1, i))]; track.scrollTo({ left: s.offsetLeft - track.offsetLeft, behavior: reduce ? 'auto' : 'smooth' }); };
      const dio = new IntersectionObserver((es) => {
        for (const e of es) if (e.isIntersecting) { cur = Number((e.target as HTMLElement).dataset.i); chips.forEach((c, j) => c.classList.toggle('is-on', j === cur)); }
      }, { root: track, threshold: 0.6 });
      stops.forEach((s) => dio.observe(s));
      chips.forEach((c, i) => c.addEventListener('click', (e) => { e.preventDefault(); go(i); }));
      day.querySelectorAll<HTMLButtonElement>('[data-day-prev],[data-day-next]').forEach((b) => { b.hidden = false; b.addEventListener('click', () => go(cur + (b.hasAttribute('data-day-next') ? 1 : -1))); });
      track.addEventListener('keydown', (e) => { const k = (e as KeyboardEvent).key; if (k === 'ArrowRight') { e.preventDefault(); go(cur + 1); } if (k === 'ArrowLeft') { e.preventDefault(); go(cur - 1); } });
    }
  }
</script>
