---
// Redesign 0.23.0, block 8c-2 (WS-SiteHome r16, WM-SiteMobile r16): the tips window during a call, in HTML, in the
// site's style: the mark with the listening ring, the level bars, an Answer card with the phrase on its plate, and a
// New request note. It replaces the hero screenshot. The call is in English, so the card and the quote stay English;
// the window's labels follow the page language, as the app does.
import PnMark from './PnMark.astro';
import PnBars from './PnBars.astro';
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang; compact?: boolean }
const { lang, compact = false } = Astro.props;
const T = lang === 'uk'
  ? { aria: 'Вікно підказок під час дзвінка', listening: 'Слухаю', answer: 'Відповідь', now: 'зараз', src: 'З документів', nr: 'Новий запит', advice: 'Не погоджуйтесь одразу.', t: '1,4 с' }
  : { aria: 'The tips window during a call', listening: 'Listening', answer: 'Answer', now: 'now', src: 'From docs', nr: 'New request', advice: 'Do not agree now.', t: '1.4 s' };
---
<figure class:list={['pn-win', { 'pn-win--compact': compact }]} aria-label={T.aria}>
  <div class="pn-win__bar">
    <PnMark kind="ping" size={compact ? 20 : 22} />
    <span class="pn-win__title">Orbit weekly</span>
    <span class="pn-win__rec"><PnBars h={compact ? 12 : 14} />{T.listening}</span>
    {!compact && <span class="pn-win__time">12:04</span>}
  </div>
  <div class="pn-win__body">
    <div class="pn-ans">
      <p class="pn-ans__tag"><b>{T.answer}</b><span>{T.now} · when is the export live?</span></p>
      <p class="pn-ans__a" lang="en"><span class="pn-ph">On dev now. Production on Tuesday, after the review.</span></p>
      <p class="pn-ans__src">{T.src} · kickoff-notes.md · {T.t}</p>
    </div>
    {!compact && (
      <div class="pn-win__nr">
        <p class="pn-win__nrk"><span>{T.nr}</span></p>
        <p class="pn-win__nrt">{T.advice} <span lang="en">“Good idea. I will write it down, and we will come back to you.”</span></p>
      </div>
    )}
  </div>
</figure>
