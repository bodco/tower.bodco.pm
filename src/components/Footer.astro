---
import { PAGES, LINKS, VERSION, t, path, getLangFromUrl } from '../i18n/ui';
const lang = getLangFromUrl(Astro.url);
const learn = PAGES.filter((p) => !['start', 'changelog'].includes(p.slug));
---
<footer class="site-footer">
  <div class="footer wrap">
    <div class="footer__about">
      <b><span aria-hidden="true">🗼</span> PM Control Tower</b>
      <span>{t(lang, 'footer.about')}</span>
      <span class="label">v{VERSION} · {lang === 'uk' ? 'бета' : 'beta'} · MIT</span>
    </div>
    <div class="footer__cols">
      <div class="footer__col">
        <span class="label">{t(lang, 'footer.get')}</span>
        <a href={LINKS.notion}>{t(lang, 'footer.notion')}</a>
        <a href={LINKS.repo}>{t(lang, 'footer.repo')}</a>
        <a href={path(lang, 'start')}>{t(lang, 'nav.start')}</a>
        <a href={path(lang, 'changelog')}>{t(lang, 'nav.changelog')}</a>
      </div>
      <div class="footer__col">
        <span class="label">{t(lang, 'footer.learn')}</span>
        {learn.map((p) => <a href={path(lang, p.slug)}>{t(lang, `nav.${p.slug}` as any)}</a>)}
      </div>
      <div class="footer__col">
        <span class="label">{t(lang, 'footer.more')}</span>
        <a href={LINKS.docs(lang)}>{t(lang, 'footer.docs')}</a>
        <a href={LINKS.site}>{t(lang, 'footer.source')}</a>
        <a href={LINKS.author(lang)}>{t(lang, 'footer.author')}</a>
        <a href={path(lang, 'privacy')}>{t(lang, 'nav.privacy')}</a>
        <a href={path(lang, 'terms')}>{t(lang, 'nav.terms')}</a>
        <a href={path(lang, 'live-tips/privacy')}>Live Tips: {t(lang, 'nav.live-tips-privacy').toLowerCase()}</a>
        <button type="button" class="footer__consent" id="consent-reset">{t(lang, 'footer.consent')}</button>
      </div>
    </div>
  </div>
</footer>
<script is:inline>
  // 2026-10-27: forget the analytics choice and show the consent banner again.
  (function () {
    var b = document.getElementById('consent-reset');
    if (b) b.addEventListener('click', function () {
      try { localStorage.removeItem('analytics-consent'); } catch (e) {}
      location.reload();
    });
  })();
</script>
