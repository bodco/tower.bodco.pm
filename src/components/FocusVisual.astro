---
/**
 * FocusVisual: the Focus desk as an idea, not as a screenshot.
 * The real Focus desk in Notion changes often (widget names, counts, order, layout), so this schematic
 * shows only what does not change: overnight the skills fill the same records, in the morning one place
 * answers "what needs me today", and the morning is done when every answer is "nothing".
 * No widget names, no counts, no fake UI chrome, no page layout.
 * Facts: docs/en/02-notion-control-tower.md ("The CONTROL TOWER page", "A day with the hub").
 * Themes through the site's CSS variables.
 */
interface Props { lang?: 'en' | 'uk' }
const { lang = 'en' } = Astro.props;

const T = {
  en: {
    title: 'Focus desk, the idea',
    tag: 'Schematic',
    nightLabel: 'Overnight',
    nightNote: 'the skills fill your records',
    sources: ['Chats', 'Mail', 'Meetings', 'Tracker'],
    records: 'tasks · threads · risks · reports',
    deskLabel: 'In the morning',
    deskNote: 'one place',
    deskQ: 'What needs me today?',
    deskSub: 'Views of the original records, not a second list.',
    questions: [
      ['What do I do next?', 'tasks'],
      ['Who is waiting for my reply?', 'threads'],
      ['Whom should I nudge?', 'threads'],
      ['Which risks need me?', 'risks'],
      ['What came in overnight?', 'reports'],
      ['What is slipping?', 'tasks'],
    ],
    srFrom: 'answered from',
    doneTitle: 'Done when every answer is "nothing".',
    doneText: 'The rest of the day is for priorities, people and the client.',
    foot: 'Schematic, not a screenshot. The widgets, names and layout in your Notion will differ and can change. Nothing here is kept by hand.',
  },
  uk: {
    title: 'Focus desk, суть',
    tag: 'Схема',
    nightLabel: 'Вночі',
    nightNote: 'скіли заповнюють ваші записи',
    sources: ['Чати', 'Пошта', 'Мітинги', 'Трекер'],
    records: 'задачі · треди · ризики · звіти',
    deskLabel: 'Зранку',
    deskNote: 'одне місце',
    deskQ: 'Що сьогодні потребує мене?',
    deskSub: 'Вʼю оригінальних записів, а не другий список.',
    questions: [
      ['Що робити далі?', 'задачі'],
      ['Хто чекає на мою відповідь?', 'треди'],
      ['Кому треба нагадати?', 'треди'],
      ['Які ризики потребують мене?', 'ризики'],
      ['Що прийшло за ніч?', 'звіти'],
      ['Що вже прострочено?', 'задачі'],
    ],
    srFrom: 'відповідь з',
    doneTitle: 'Готово, коли на кожне питання відповідь "нічого".',
    doneText: 'Решта дня для пріоритетів, людей і клієнта.',
    foot: 'Схема, не скриншот. Віджети, назви і розкладка у вашому Notion будуть іншими і можуть змінюватися. Нічого тут не ведеться вручну.',
  },
}[lang];
const id = `fv-${lang}`;
---
<figure class="fv" aria-labelledby={`${id}-t`}>
  <div class="fv__head">
    <span aria-hidden="true">🗼</span>
    <span class="fv__title" id={`${id}-t`}>{T.title}</span>
    <span class="fv__tag">{T.tag}</span>
  </div>

  <div class="fv__night">
    <p class="fv__label">{T.nightLabel}<span class="fv__note">{T.nightNote}</span></p>
    <div class="fv__feed">
      <ul class="fv__sources">{T.sources.map((s) => <li>{s}</li>)}</ul>
      <span class="fv__arrow" aria-hidden="true">
        <svg width="28" height="14" viewBox="0 0 28 14" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M1 7h24M19 1l6 6-6 6"/></svg>
      </span>
      <span class="fv__records">{T.records}</span>
    </div>
  </div>

  <div class="fv__drop" aria-hidden="true"><span></span></div>

  <div class="fv__desk">
    <p class="fv__label">{T.deskLabel}<span class="fv__note">{T.deskNote}</span></p>
    <p class="fv__q">{T.deskQ}</p>
    <ul class="fv__list">
      {T.questions.map(([q, from]) => (
        <li><span class="fv__qq">{q}</span><span class="fv__from"><span class="sr">{T.srFrom} </span>{from}</span></li>
      ))}
    </ul>
    <p class="fv__sub">{T.deskSub}</p>
  </div>

  <div class="fv__drop" aria-hidden="true"><span></span></div>

  <div class="fv__done">
    <span class="fv__check" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
    </span>
    <div class="fv__done-text">
      <b>{T.doneTitle}</b>
      <span>{T.doneText}</span>
    </div>
  </div>

  <figcaption class="fv__foot">{T.foot}</figcaption>
</figure>

<style>
  .fv {
    margin: 2em 0 0; min-width: 0;
    border: 1px solid var(--line-strong); background: var(--surface);
    font-family: var(--sans); color: var(--text); line-height: 1.45;
  }
  .fv p { margin: 0; }
  .fv ul { list-style: none; margin: 0; padding: 0; }
  .fv li { margin: 0; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .fv__head {
    display: flex; align-items: center; gap: 10px; padding: 12px 18px;
    border-bottom: 1px solid var(--line-strong);
    font-family: var(--mono); font-size: 12px; color: var(--text-3);
  }
  .fv__title { flex: 1; min-width: 0; letter-spacing: 0.04em; }
  .fv__tag { border: 1px dashed var(--line-button); padding: 3px 8px; font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase; }

  .fv__label {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; margin-bottom: 12px !important;
    font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-2);
  }
  .fv__note { letter-spacing: 0.04em; text-transform: none; color: var(--text-3); }
  .fv__note::before { content: '/ '; color: var(--muted-sep); }

  /* Overnight: background work, faint hatch like the hero's autopilot shift. */
  .fv__night {
    padding: 18px 22px 20px;
    background-image: repeating-linear-gradient(135deg, var(--grid-line) 0 1px, transparent 1px 9px);
  }
  .fv__feed { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; }
  .fv__sources { display: flex; flex-wrap: wrap; gap: 6px; }
  .fv__sources li { font-size: 13px; color: var(--text-2); border: 1px dashed var(--line-button); padding: 4px 9px; }
  .fv__arrow { color: var(--accent); display: flex; }
  .fv__records { font-family: var(--mono); font-size: 12.5px; color: var(--text); border: 1px solid var(--line-strong); background: var(--bg); padding: 5px 10px; }

  .fv__drop { display: flex; justify-content: center; height: 22px; }
  .fv__drop span { width: 0; border-left: 1.5px dashed var(--accent); }

  /* The desk: the one thing that is solid. */
  .fv__desk {
    margin: 0 22px; padding: 18px 20px 16px;
    border: 1px solid var(--accent); background: var(--surface-warm);
  }
  .fv__q { font-size: 22px; font-weight: 700; letter-spacing: -0.015em; line-height: 1.2; margin-bottom: 12px !important; }
  .fv__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 24px; }
  .fv__list li {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 2px 12px;
    padding: 9px 0 9px 20px; border-top: 1px solid var(--line-strong); position: relative; font-size: 15px;
  }
  .fv__list li::before {
    content: ''; position: absolute; left: 2px; top: 16px; width: 8px; height: 8px;
    border: 1.5px solid var(--accent); background: transparent;
  }
  .fv__qq { font-weight: 500; }
  .fv__from { font-family: var(--mono); font-size: 12px; color: var(--text-3); }
  .fv__sub { margin-top: 10px !important; font-size: 13.5px; color: var(--text-2); }

  /* Done: the quiet, empty state. */
  .fv__done {
    margin: 0 22px 22px; padding: 16px 18px;
    display: flex; gap: 14px; align-items: flex-start;
    border: 1px dashed var(--line-button); background: var(--bg);
  }
  .fv__check { flex: none; display: flex; align-items: center; justify-content: center; width: 34px; height: 34px; border: 1.5px solid var(--text); color: var(--text); }
  .fv__done-text { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .fv__done-text b { font-size: 16px; font-weight: 600; }
  .fv__done-text span { font-size: 14px; color: var(--text-2); }

  .fv__foot { padding: 12px 18px; border-top: 1px solid var(--line-strong); font-family: var(--mono); font-size: 12px; line-height: 1.55; color: var(--text-3); }

  @media (max-width: 640px) {
    .fv__list { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 480px) {
    .fv__night { padding: 16px 16px 18px; }
    .fv__desk { margin: 0 12px; padding: 16px 14px 14px; }
    .fv__done { margin: 0 12px 16px; padding: 14px; }
    .fv__q { font-size: 19px; }
    .fv__list li { font-size: 14.5px; }
    .fv__title { font-size: 11px; }
  }
</style>
