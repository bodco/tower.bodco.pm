---
// Google Analytics 4 with Consent Mode v2: nothing is stored until the visitor accepts.
interface Props { id: string; lang: 'en' | 'uk' }
const { id, lang } = Astro.props;
const text = lang === 'uk'
  ? { msg: 'Сайт використовує Google Analytics (cookies) для підрахунку відвідувань. Дозволити?', yes: 'Дозволити', no: 'Відмовитися' }
  : { msg: 'This site uses Google Analytics (cookies) to count visits. Allow it?', yes: 'Allow', no: 'Decline' };
---
<script is:inline define:vars={{ id }}>
  window.dataLayer = window.dataLayer || [];
  function gtag() { dataLayer.push(arguments); }
  window.gtag = gtag;
  gtag('consent', 'default', {
    analytics_storage: 'denied',
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
  });
  var saved = null;
  try { saved = localStorage.getItem('analytics-consent'); } catch (e) {}
  if (saved === 'granted') gtag('consent', 'update', { analytics_storage: 'granted' });
  gtag('js', new Date());
  gtag('config', id, { allow_google_signals: false, allow_ad_personalization_signals: false });
  // 2026-10-27: strict opt-in. Google's script is loaded only after the visitor allows analytics
  // (now or on an earlier visit); without consent nothing is sent to Google at all.
  window.ltLoadGa = function () {
    if (window.ltGaLoaded) return; window.ltGaLoaded = true;
    var s = document.createElement('script'); s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
    document.head.appendChild(s);
  };
  if (saved === 'granted') window.ltLoadGa();
</script>
<div class="consent" id="consent" role="region" aria-label="Analytics consent" hidden>
  <p>{text.msg}</p>
  <div class="consent__btns">
    <button type="button" data-consent="granted">{text.yes}</button>
    <button type="button" data-consent="denied">{text.no}</button>
  </div>
</div>
<script is:inline>
  (function () {
    var box = document.getElementById('consent');
    var saved = null;
    try { saved = localStorage.getItem('analytics-consent'); } catch (e) {}
    if (!saved) box.hidden = false;
    box.addEventListener('click', function (e) {
      var v = e.target && e.target.getAttribute && e.target.getAttribute('data-consent');
      if (!v) return;
      try { localStorage.setItem('analytics-consent', v); } catch (err) {}
      if (v === 'granted') { window.gtag('consent', 'update', { analytics_storage: 'granted' }); if (window.ltLoadGa) window.ltLoadGa(); }
      box.hidden = true;
    });
  })();
</script>
<script is:inline>
  // 2026-11-05: click and reading events for the key buttons (both sites share this property,
  // tell them apart by hostname or the "site" parameter). Events wait in dataLayer and reach Google
  // only after consent, like everything else here. No personal data in any parameter.
  (function () {
    var site = /pacenote\./.test(location.hostname) || /^\/(uk\/)?pacenote\//.test(location.pathname) ? 'pacenote' : 'tower';
    function send(name, p) { p = p || {}; p.site = site; try { window.gtag('event', name, p); } catch (e) {} }
    function where(el) {
      if (el.closest('header, .site-header')) return 'header';
      if (el.closest('footer')) return 'footer';
      if (el.closest('nav')) return 'nav';
      if (el.closest('.hero, .hero-ctas, [class*="hero"]')) return 'main:hero';
      var sec = el.closest('section[id], [data-section]');
      if (sec) return 'main:' + (sec.getAttribute('data-section') || sec.id);
      var h = null, all = document.querySelectorAll('main h2[id], main h3[id]');
      for (var i = 0; i < all.length; i++) { if (all[i].compareDocumentPosition(el) & 4) h = all[i]; else break; }
      return h ? 'main:' + h.id : 'main:top';
    }
    function text(el) { return (el.getAttribute('aria-label') || el.textContent || '').replace(/\s+/g, ' ').trim().slice(0, 80); }
    document.addEventListener('click', function (e) {
      var el = e.target && e.target.closest && e.target.closest('a, button');
      if (!el) return;
      var base = { link_text: text(el), link_location: where(el) };
      if (el.tagName === 'BUTTON') {
        if (el.classList.contains('theme-btn')) return send('theme_toggle', base);
        if (el.classList.contains('menu-btn')) return send('menu_toggle', { link_location: base.link_location, open: el.getAttribute('aria-expanded') === 'true' ? 0 : 1 });
        if (el.id === 'consent-reset') return send('consent_reset', base);
        if (el.hasAttribute('data-consent')) return;
        return send('button_click', base);
      }
      var href = el.getAttribute('href') || '';
      if (!href || href.charAt(0) === '#') return send('anchor_click', { link_text: base.link_text, link_location: base.link_location, link_url: href });
      var u; try { u = new URL(href, location.href); } catch (err) { return; }
      base.link_url = u.href.slice(0, 200);
      base.link_domain = u.hostname;
      if (el.hasAttribute('hreflang') && el.closest('.lang')) return send('lang_switch', { to: el.getAttribute('hreflang'), link_location: base.link_location });
      if (/\.dmg$/i.test(u.pathname)) { base.file_name = u.pathname.split('/').pop(); return send('download_app', base); }
      if (/\.skill$/i.test(u.pathname)) { base.file_name = u.pathname.split('/').pop(); return send('download_skill', base); }
      if (/\.plugin$/i.test(u.pathname)) { base.file_name = u.pathname.split('/').pop(); return send('download_plugin', base); }
      if (/(^|\.)notion\.(site|so)$/.test(u.hostname)) return send('notion_template_click', base);
      if (u.hostname === 'github.com') { base.repo = u.pathname.split('/').slice(1, 3).join('/'); return send('github_click', base); }
      if (/(^|\.)bodco\.pm$/.test(u.hostname) && u.hostname !== location.hostname) return send('cross_site_click', base);
      if (u.hostname !== location.hostname) return send('outbound_link', base);
      base.link_url = u.pathname + u.hash;
      delete base.link_domain;
      if (/\b(btn|button|cta)\b/i.test(el.className || '') || el.closest('.hero, .cta, [class*="cta"]')) return send('cta_click', base);
      send(base.link_location === 'header' || base.link_location === 'nav' || base.link_location === 'footer' ? 'nav_click' : 'content_link', base);
    }, true);
    // how far people read: 25/50/75/100 % of the page, and which sections came into view
    var marks = [25, 50, 75, 100], hit = {};
    function onScroll() {
      var d = document.documentElement, max = d.scrollHeight - window.innerHeight;
      var pct = max > 0 ? Math.round((window.scrollY / max) * 100) : 100;
      for (var i = 0; i < marks.length; i++) if (pct >= marks[i] && !hit[marks[i]]) { hit[marks[i]] = 1; send('scroll_depth', { percent: marks[i] }); }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    if ('IntersectionObserver' in window) {
      var seen = {};
      var io = new IntersectionObserver(function (es) {
        es.forEach(function (x) {
          if (!x.isIntersecting || seen[x.target.id]) return;
          seen[x.target.id] = 1; io.unobserve(x.target);
          send('section_view', { section_id: x.target.id, section_title: text(x.target).slice(0, 60) });
        });
      }, { rootMargin: '0px 0px -40% 0px' });
      document.querySelectorAll('main h2[id]').forEach(function (h) { io.observe(h); });
    }
  })();
</script>
<style is:global>
  .consent { position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 50; max-width: 560px;
    display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; padding: 14px 16px;
    background: var(--surface, #12151a); color: var(--text, #ecedef);
    border: 1px solid var(--line-strong, #2c313a); border-left: 3px solid var(--accent, #e8492f);
    font: 14px/1.45 var(--sans, system-ui, sans-serif); box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35); }
  .consent[hidden] { display: none; }
  .consent p { margin: 0; flex: 1 1 260px; }
  .consent__btns { display: flex; gap: 8px; }
  .consent button { font: inherit; cursor: pointer; padding: 8px 14px; color: var(--text, #ecedef);
    background: transparent; border: 1px solid var(--line-button, #3a404a); }
  .consent button[data-consent="granted"] { background: var(--accent, #e8492f); color: var(--on-accent, #0e1014); border-color: var(--accent, #e8492f); }
  .consent button:focus-visible { outline: 2px solid var(--accent, #e8492f); outline-offset: 2px; }
</style>
