---
// 2026-11-04 (owner): Pacenote is its own product with its own site, so its pages get their own header
// (no PM Control Tower menu or brand). Used by Base.astro when brand === 'pacenote'.
// Redesign 0.23.0, block 8c (_wsite.hdr.html, WS-SiteHome r16): lockup, Overview / How it works / Pricing / Compare
// with the current page underlined, EN · UK, GitHub, Download. No style or mode switch (Bohdan 18.11: the site follows
// Platform > Style). Class names menu-btn and lang stay: Analytics.astro counts them.
import PacenoteLockup from './PacenoteLockup.astro';
import '../styles/pacenote-theme.css';
import '../styles/pacenote-brand.css';
import '../styles/pacenote-site.css';
import { languages, getLangFromUrl, switchLang, pnHref, type Lang } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const is404 = Astro.url.pathname.startsWith('/pn404');
// 'pricing' for /pacenote/pricing/ and /uk/pacenote/pricing/, '' for the product page.
const sub = Astro.url.pathname.split('/').filter(Boolean).filter((s) => s !== 'uk' && s !== 'pacenote')[0] ?? '';
const DMG = 'https://github.com/bodco/live-tips/releases/latest/download/Pacenote.dmg';
const REPO = 'https://github.com/bodco/live-tips';
const T = lang === 'uk'
  ? { overview: 'Огляд', details: 'Як працює', pricing: 'Ціни', compare: 'Порівняння', dl: 'Завантажити', menu: 'Меню', langLabel: 'Мова', home: 'Pacenote, головна' }
  : { overview: 'Overview', details: 'How it works', pricing: 'Pricing', compare: 'Compare', dl: 'Download', menu: 'Menu', langLabel: 'Language', home: 'Pacenote home' };
const links = [
  { sub: '', label: T.overview },
  { sub: 'details', label: T.details },
  { sub: 'pricing', label: T.pricing },
  { sub: 'compare', label: T.compare },
];
const langHref = (l: Lang) => (is404 ? pnHref(l) : switchLang(Astro.url, l));
const langs = Object.keys(languages) as Lang[];
const LANG_NAME: Record<Lang, string> = { en: 'English', uk: 'Українська' };
---
<header class="site-header">
  <nav class="pn-nav wrap" aria-label="Main" data-open="false">
    <a class="pn-nav__home" href={pnHref(lang)} aria-label={T.home}><PacenoteLockup /></a>
    <ul class="pn-nav__links" id="nav-links">
      {links.map((l) => (
        <li><a href={pnHref(lang, l.sub)} aria-current={!is404 && sub === l.sub ? 'page' : undefined}>{l.label}</a></li>
      ))}
      <li class="pn-nav__dl"><a href={DMG} download>{T.dl}</a></li>
      {/* 8c-2 (WM-SiteMobile): on a phone the menu also carries the languages by name and GitHub. */}
      <li class="pn-nav__extra lang">
        {langs.map((l) => <a href={langHref(l)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{LANG_NAME[l]}</a>)}
        <a class="pn-nav__gh" href={REPO}>GitHub</a>
      </li>
    </ul>
    <div class="pn-nav__tools">
      <div class="pn-langs lang" role="group" aria-label={T.langLabel}>
        {langs.map((l, i) => (
          <>{i > 0 && <span aria-hidden="true">·</span>}<a href={langHref(l)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a></>
        ))}
      </div>
      <a class="pn-gh" href={REPO}>GitHub</a>
      <a class="pn-btn" href={DMG} download>{T.dl}</a>
      <button class="pn-menu-btn menu-btn" type="button" aria-controls="nav-links" aria-expanded="false" aria-label={T.menu}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </nav>
</header>
<script>
  const nav = document.querySelector<HTMLElement>('.pn-nav');
  const btn = document.querySelector<HTMLButtonElement>('.pn-menu-btn');
  btn?.addEventListener('click', () => {
    setOpen(nav?.dataset.open !== 'true');
  });
  // 8c-2 (WM-SiteMobile): the open menu covers the page; the icon turns into a cross and the page does not scroll.
  const ICON = { open: 'M6 6l12 12M18 6L6 18', closed: 'M4 7h16M4 12h16M4 17h16' };
  function setOpen(open: boolean) {
    if (nav) nav.dataset.open = String(open);
    btn?.setAttribute('aria-expanded', String(open));
    btn?.querySelector('path')?.setAttribute('d', open ? ICON.open : ICON.closed);
    document.documentElement.classList.toggle('pn-menu-open', open);
  }
  window.matchMedia('(min-width: 901px)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav?.dataset.open === 'true') {
      setOpen(false);
      btn?.focus();
    }
  });
</script>
