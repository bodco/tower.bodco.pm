---
// 2026-11-04 (owner): Pacenote is its own product with its own site, so its pages get their own header
// (no PM Control Tower menu or brand). Used by Base.astro when brand === 'pacenote'.
import PacenoteLogo from './PacenoteLogo.astro';
import { languages, getLangFromUrl, switchLang, pnHref, type Lang } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const is404 = Astro.url.pathname.startsWith('/pn404');
// 'pricing' for /pacenote/pricing/ and /uk/pacenote/pricing/, '' for the product page.
const sub = Astro.url.pathname.split('/').filter(Boolean).filter((s) => s !== 'uk' && s !== 'pacenote')[0] ?? '';
const DMG = 'https://github.com/bodco/live-tips/releases/latest/download/Pacenote.dmg';
const REPO = 'https://github.com/bodco/live-tips';
const T = lang === 'uk'
  ? { overview: 'Огляд', details: 'Як працює', pricing: 'Ціни', compare: 'Порівняння', dl: 'Завантажити', menu: 'Меню', theme: 'Темна тема', langLabel: 'Мова' }
  : { overview: 'Overview', details: 'How it works', pricing: 'Pricing', compare: 'Compare', dl: 'Download', menu: 'Menu', theme: 'Dark theme', langLabel: 'Language' };
const links = [
  { sub: '', label: T.overview },
  { sub: 'details', label: T.details },
  { sub: 'pricing', label: T.pricing },
  { sub: 'compare', label: T.compare },
];
const langHref = (l: Lang) => (is404 ? pnHref(l) : switchLang(Astro.url, l));
---
<header class="site-header">
  <nav class="nav wrap" aria-label="Main" data-open="false">
    <a class="brand pn-brand" href={pnHref(lang)}><PacenoteLogo /> Pacenote</a>
    <div class="nav__tools">
      <div class="lang" role="group" aria-label={T.langLabel}>
        {(Object.keys(languages) as Lang[]).map((l) => (
          <a href={langHref(l)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{languages[l]}</a>
        ))}
      </div>
      <button class="theme-btn" type="button" aria-label={T.theme} title={T.theme} aria-pressed="false">
        <svg class="i-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"/></svg>
        <svg class="i-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <a class="gh" href={REPO} aria-label="GitHub">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M9 19c-4 1.5-4-2-6-2.5M15 22v-3.5a3 3 0 0 0-.9-2.4c3-.3 6-1.5 6-6.6a5 5 0 0 0-1.4-3.6 4.7 4.7 0 0 0-.1-3.6s-1.1-.3-3.7 1.4a12.6 12.6 0 0 0-6.6 0C5.7 2 4.6 2.3 4.6 2.3a4.7 4.7 0 0 0-.1 3.6A5 5 0 0 0 3 9.5c0 5.1 3 6.3 6 6.6a3 3 0 0 0-.9 2.4V22"/></svg>
        <span>GitHub</span>
      </a>
      <a class="btn btn--primary pn-dl" href={DMG} download>{T.dl}</a>
      <button class="menu-btn" type="button" aria-controls="nav-links" aria-expanded="false" aria-label={T.menu}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
    <ul class="nav__links" id="nav-links">
      {links.map((l) => (
        <li><a href={pnHref(lang, l.sub)} aria-current={!is404 && sub === l.sub ? 'page' : undefined}>{l.label}</a></li>
      ))}
      <li class="pn-dl-mobile"><a href={DMG} download>{T.dl}</a></li>
      <li class="nav__lang-mobile">
        <div class="lang" role="group" aria-label={T.langLabel}>
          {(Object.keys(languages) as Lang[]).map((l) => (
            <a href={langHref(l)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{languages[l]}</a>
          ))}
        </div>
      </li>
    </ul>
  </nav>
</header>
<style is:inline>
  .pn-brand svg.logo { width: 26px; height: 26px; flex: none; color: var(--text); }
  .pn-dl { min-height: 36px; padding: 6px 14px; font-size: 14px; }
  .pn-dl-mobile { display: none; }
  @media (max-width: 900px) { .pn-dl { display: none; } .pn-dl-mobile { display: list-item; } }
</style>
<script>
  const themeBtn = document.querySelector<HTMLButtonElement>('.theme-btn');
  const syncTheme = () => themeBtn?.setAttribute('aria-pressed', String(document.documentElement.dataset.theme === 'dark'));
  syncTheme();
  themeBtn?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'light' ? '#F6F5F1' : '#0E1014');
    syncTheme();
  });
  const nav = document.querySelector<HTMLElement>('.nav');
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  btn?.addEventListener('click', () => {
    const open = nav?.dataset.open !== 'true';
    if (nav) nav.dataset.open = String(open);
    btn.setAttribute('aria-expanded', String(open));
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav?.dataset.open === 'true') {
      nav.dataset.open = 'false';
      btn?.setAttribute('aria-expanded', 'false');
      btn?.focus();
    }
  });
</script>
