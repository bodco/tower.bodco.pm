---
import Tower from './Tower.astro';
import { PAGES, LINKS, languages, t, path, pnHref, switchLang, getLangFromUrl, type Lang } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const current = Astro.url.pathname.replace(/\/$/, '').split('/').pop();
const navPages = PAGES.filter((p) => p.nav);
---
<header class="site-header">
  <nav class="nav wrap" aria-label="Main" data-open="false">
    <a class="brand" href={path(lang)}><Tower /> PM Control Tower</a>
    <div class="nav__tools">
      <div class="lang" role="group" aria-label={t(lang, 'lang.label')}>
        {(Object.keys(languages) as Lang[]).map((l) => (
          <a href={current === '404' ? (l === 'en' ? '/' : '/uk/') : switchLang(Astro.url, l)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{languages[l]}</a>
        ))}
      </div>
      <button class="theme-btn" type="button" aria-label={t(lang, 'theme.label')} title={t(lang, 'theme.label')} aria-pressed="false">
        <svg class="i-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"/></svg>
        <svg class="i-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      {/* 2026-11-28 (owner): back on, bodco.pm is now the bodco front page (not a CV). New bodco mark. */}
      <a class="gh author-link" href={LINKS.author(lang)} title={t(lang, 'author.title')} aria-label={t(lang, 'author.title')}>
        <svg class="mark" viewBox="0 0 1000 1000" aria-hidden="true"><rect width="1000" height="1000" rx="0" fill="#0B0B0C"/><g transform="translate(91.0 840.0) scale(0.46980)"><path fill="#FFFFFF" d="M796.0 14Q718.0 14 656.5 -12.0Q595.0 -38 552.0 -82.5Q509.0 -127 486.0 -184H476.0V0H78.0V-1490H480.0V-922H486.0Q508.0 -979 550.0 -1027.0Q592.0 -1075 654.5 -1103.5Q717.0 -1132 800.0 -1132Q911.0 -1132 1010.5 -1073.0Q1110.0 -1014 1173.0 -887.5Q1236.0 -761 1236.0 -558Q1236.0 -365 1176.0 -238.0Q1116.0 -111 1016.0 -48.5Q916.0 14 796.0 14ZM648.0 -294Q704.0 -294 742.5 -325.5Q781.0 -357 801.5 -416.5Q822.0 -476 822.0 -558Q822.0 -641 801.5 -700.5Q781.0 -760 742.5 -792.0Q704.0 -824 648.0 -824Q593.0 -824 553.0 -792.0Q513.0 -760 491.5 -700.5Q470.0 -641 470.0 -558Q470.0 -477 491.5 -418.0Q513.0 -359 553.0 -326.5Q593.0 -294 648.0 -294Z"/></g><rect fill="#5552FF" x="714.9" y="682.6" width="157.4" height="157.4"/></svg>
        <span>bodco.pm</span>
      </a>
      <a class="gh" href={LINKS.repo} aria-label="GitHub">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M9 19c-4 1.5-4-2-6-2.5M15 22v-3.5a3 3 0 0 0-.9-2.4c3-.3 6-1.5 6-6.6a5 5 0 0 0-1.4-3.6 4.7 4.7 0 0 0-.1-3.6s-1.1-.3-3.7 1.4a12.6 12.6 0 0 0-6.6 0C5.7 2 4.6 2.3 4.6 2.3a4.7 4.7 0 0 0-.1 3.6A5 5 0 0 0 3 9.5c0 5.1 3 6.3 6 6.6a3 3 0 0 0-.9 2.4V22"/></svg>
        <span>GitHub</span>
      </a>
      <button class="menu-btn" type="button" aria-controls="nav-links" aria-expanded="false" aria-label={t(lang, 'menu')}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
    <ul class="nav__links" id="nav-links">
      {navPages.map((p) => (
        <li><a href={p.slug === 'pacenote' ? pnHref(lang) : path(lang, p.slug)} aria-current={current === p.slug ? 'page' : undefined}>{t(lang, `nav.${p.slug}` as any)}</a></li>
      ))}
      <li class="nav__lang-mobile">
        <div class="lang" role="group" aria-label={t(lang, 'lang.label')}>
          {(Object.keys(languages) as Lang[]).map((l) => (
            <a href={current === '404' ? (l === 'en' ? '/' : '/uk/') : switchLang(Astro.url, l)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{languages[l]}</a>
          ))}
        </div>
      </li>
    </ul>
  </nav>
</header>
<script>
  const themeBtn = document.querySelector<HTMLButtonElement>('.theme-btn');
  const syncTheme = () => themeBtn?.setAttribute('aria-pressed', String(document.documentElement.dataset.theme === 'dark'));
  syncTheme();
  themeBtn?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'light' ? '#F6F5F1' : '#0E1014');
    syncTheme();
  });
  const nav = document.querySelector<HTMLElement>('.nav');
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  btn?.addEventListener('click', () => {
    const open = nav?.dataset.open !== 'true';
    if (nav) nav.dataset.open = String(open);
    btn.setAttribute('aria-expanded', String(open));
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav?.dataset.open === 'true') {
      nav.dataset.open = 'false';
      btn?.setAttribute('aria-expanded', 'false');
      btn?.focus();
    }
  });
</script>
