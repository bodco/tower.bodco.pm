---
import Base from '../layouts/Base.astro';
import Tower from '../components/Tower.astro';
---
<Base title="404" noindex>
  <section class="wrap section stack" style="align-items: flex-start;">
    <Tower size={44} />
    <p class="eyebrow">404</p>
    <h1 class="h1 h1--page">This page is off the radar</h1>
    <p class="lead">The link may be old, or the page moved. Start from the home page.</p>
    <p class="lead" lang="uk">Цієї сторінки немає на радарі. Почніть з головної.</p>
    <div class="btns"><a class="btn btn--primary" href="/">Home</a><a class="btn" href="/uk/">Головна</a></div>
  </section>
</Base>
