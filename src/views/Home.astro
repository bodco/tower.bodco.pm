  startEyebrow: 'Як розгорнути в себе',
  startH: 'Вечір на старт, кілька тижнів на притирку',
  startP: 'Потрібні Мак, підписка Claude Max і акаунт Notion. Для основи Terminal не знадобиться: кожен промпт уже написаний. Slack, пошта, Jira, розклад і підказувач на дзвінку потім, кожне окремо і тоді, коли справді забракне.',
  startBtn: 'Розгорнути крок за кроком',
  steps: [
    ['Дублюйте шаблон Notion', '11 повʼязаних баз з демо-даними, які потім можна видалити.', ''],
    ['Встановіть плагін', 'Перетягніть файл плагіна (dist/pm-control-tower.plugin з репозиторію) у чат Cowork і натисніть Install.', ''],
    ['Дайте Claude підключити ваш Notion', 'ID баз він знайде сам.', 'customize the pm-control-tower plugin for me'],
    ['Додайте перший проєкт', 'Claude розпитає про команду, мітинги й інструменти і сам напише файл проєкту.', 'заведи новий проєкт Orbit, case A'],
    ['Спробуйте', '', 'підготуй мене до синку по Orbit'],
  ],
},
}[lang];

const groups = Object.keys(GROUPS).filter((g) => g !== 'found');
---
<Base>
  <!-- 1. HERO: what changes for you -->
  <section class="wrap" style="padding-top: 88px; padding-bottom: 88px;">
    <div class="split">
      <div class="stack" style="gap: 28px; flex-basis: 520px;">
        <p class="eyebrow eyebrow--muted">{C.eyebrow}</p>
        <h1 class="h1 h1--hero">{C.h1}</h1>
        <p class="lead" style="font-size: 19px; max-width: 580px;">{C.lead}</p>
        <div class="btns">
          <a class="btn btn--primary" href={LINKS.notion}><NotionLogo /> {t(lang, 'cta.notion.hero')}</a>
          <a class="btn btn--primary" href={LINKS.repo}><GithubLogo /> {t(lang, 'cta.repo.hero')}</a>
          <a class="btn" href={path(lang, 'start')}>{t(lang, 'cta.setup')} <Arrow /></a>
        </div>
        <ul class="chips">{C.chips.map((c) => <li>{c}</li>)}</ul>
      </div>
      <div style="min-width: 0;"><HeroVisual lang={lang} /></div>
    </div>
  </section>

  <!-- 2. BEFORE -->
  <section class="band" aria-labelledby="problem-h">
    <div class="wrap section--tight">
      <div class="head-row">
        <h2 id="problem-h" class="h2 h2--sm" style="max-width: 660px;">{C.problemH}</h2>
        <p class="muted" style="margin: 0; max-width: 420px; line-height: 1.6;">{C.problemP}</p>
      </div>
      <div class="grid grid--seams" style="--min: 220px;">
        {C.problem.map(([n, s]) => <div class="stat"><b>{n}</b><span>{s}</span></div>)}
      </div>
    </div>
  </section>

  <!-- 3. AFTER: the same day now -->
  <section class="wrap section" aria-labelledby="day-h">
    <div class="head-row">
      <div class="stack" style="gap: 16px; max-width: 720px;">
        <p class="eyebrow">{C.dayEyebrow}</p>
        <h2 id="day-h" class="h2">{C.dayH}</h2>
      </div>
      <a class="more" href={path(lang, 'day')}>{C.dayMore} <Arrow /></a>
    </div>
    <ol class="timeline">
      {C.day.map(([when, title, text]) => <li><code>{when.toUpperCase()}</code><b>{title}</b><span>{text}</span></li>)}
    </ol>
  </section>

  <!-- 4. TIME BACK -->
  <section class="band" aria-labelledby="time-h">
    <div class="wrap section split" style="align-items: flex-start;">
      <div class="stack" style="flex-basis: 340px;">
        <p class="eyebrow">{C.timeEyebrow}</p>
        <h2 id="time-h" class="h2">{C.timeH}</h2>
        <p class="muted" style="margin: 0; line-height: 1.65;">{C.timeP}</p>
      </div>
      <div class="table-box" style="flex-basis: 560px;">
        <table class="table">
          <thead><tr>{C.timeCols.map((c, i) => <th scope="col" style={i === 3 ? 'width: 34%' : undefined}>{c}</th>)}</tr></thead>
          <tbody>
            {C.time.map(([task, before, after, pct]) => (
              <tr><td>{task}</td><td class="muted">{before}</td><td>{after}</td><td><div class="bar"><span style={`width:${pct}%`}></span><code>{pct === 99 ? '~99' : pct}%</code></div></td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 5. ON THE CALL -->
  <section class="wrap section split" aria-labelledby="live-h">
    <div class="card" style="padding: 0; gap: 0;">
      <div class="label" style="display: flex; align-items: center; gap: 10px; padding: 14px 18px; border-bottom: 1px solid var(--line-strong); letter-spacing: 0.06em;"><span style="width: 8px; height: 8px; border-radius: 50%; background: var(--accent);" aria-hidden="true"></span>{C.liveHead}</div>
      <div style="padding: 22px 20px; display: flex; flex-direction: column; gap: 12px; font-size: 14.5px; line-height: 1.55;" class="muted">
        <p style="margin: 0;"><b style="color: var(--text); font-weight: 500;">{C.liveClient}:</b> <span lang="en">{C.liveL1}</span></p>
        <p style="margin: 0;"><b style="color: var(--text); font-weight: 500;">{C.liveYou}:</b> <span lang="en">{C.liveL2}</span></p>
      </div>
      <div class="tip" style="margin: 0 20px 22px;">
        <span class="card__tag" style="font-size: 11px;">{C.liveTag}</span>
        <b>{C.liveGist}</b>
        <span lang="en">{C.livePhrase}</span>
      </div>
    </div>
    <div class="stack">
      <p class="eyebrow">{C.liveEyebrow}</p>
      <h2 id="live-h" class="h2">{C.liveH}</h2>
      <p class="muted" style="margin: 0; font-size: 17px; line-height: 1.65;">{C.liveP}</p>
      <a class="more" href={path(lang, 'live-tips')}>{C.liveMore} <Arrow /></a>
    </div>
  </section>

  <!-- 6. HOW IT KNOWS YOUR PROJECT -->
  <section class="band" aria-labelledby="idea-h">
    <div class="wrap section split">
      <div class="stack">
        <p class="eyebrow">{C.ideaEyebrow}</p>
        <h2 id="idea-h" class="h2">{C.ideaH}</h2>
        <p class="muted" style="margin: 0; font-size: 18px; line-height: 1.65;">{C.ideaP1}</p>
        <p class="muted" style="margin: 0; font-size: 18px; line-height: 1.65;">{C.ideaP2}</p>
        <a class="more" href={path(lang, 'how-it-works')}>{C.ideaMore} <Arrow /></a>
      </div>
      <figure class="codefig">
        <figcaption><span>projects/orbit.md</span><span>{C.demo}</span></figcaption>
<pre><span class="c-dim"># Orbit SaaS Launch</span>
status: <span class="c-ok">active</span>
team:
  pm: Alex
  devs: [Mira, Tomas, Lena]
slack:
  channels: [orbit-dev, orbit-client]
task_tracker:
  type: jira
  api_access: <span class="c-warn">false</span>
  fallback_source: mail_buffer
meetings:
  internal_sync: Mon/Wed/Fri 12:00
  client_status: Thu 16:00
<span class="c-dim"># as of 2026-10-11</span></pre>
      </figure>
    </div>
  </section>

  <!-- 7. HOW IT WORKS -->
  <section class="wrap section" aria-labelledby="flow-h">
    <div class="head-row">
      <h2 id="flow-h" class="h2 h2--sm">{C.flowH}</h2>
      <a class="more" href={path(lang, 'how-it-works')}>{C.flowMore} <Arrow /></a>
    </div>
    <ol class="grid" style="--min: 200px; list-style: none; margin: 0; padding: 0;">
      {C.flow.map(([tag, title, text], i) => (
        <li class={`card ${i === C.flow.length - 1 ? 'card--accent' : ''}`}>
          <span class="card__tag">0{i + 1} {tag}</span>
          <h3 class="card__title">{title}</h3>
          <p class="card__text">{text}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- 8. NOTION -->
  <section class="band" aria-labelledby="notion-h">
    <div class="wrap section split">
      <div class="stack" style="flex-basis: 400px;">
        <p class="eyebrow">{C.notionEyebrow}</p>
        <h2 id="notion-h" class="h2">{C.notionH}</h2>
        <p class="muted" style="margin: 0; font-size: 17px; line-height: 1.65;">{C.notionP}</p>
        <div class="btns">
          <a class="btn btn--primary" href={LINKS.notion}><NotionLogo /> {t(lang, 'cta.notion.hero')}</a>
          <a class="btn" href={path(lang, 'notion')}>{C.notionTour}</a>
        </div>
      </div>
      <ul class="grid" style="--min: 160px; list-style: none; margin: 0; padding: 0; flex-basis: 540px; gap: 10px;">
        {C.dbs.map(([name, note]) => (
          <li class="card" style="padding: 16px 18px; gap: 4px;"><b>{name}</b><span class="db-note">{note}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 9. SKILLS -->
  <section class="wrap section" aria-labelledby="skills-h">
    <div class="head-row">
      <div class="stack" style="gap: 16px; max-width: 680px;">
        <p class="eyebrow">{C.skillsEyebrow}</p>
        <h2 id="skills-h" class="h2">{C.skillsH}</h2>
        <p class="muted" style="margin: 0; font-size: 17px; line-height: 1.6;">{C.skillsP}</p>
      </div>
      <a class="btn" href={path(lang, 'skills')}>{C.skillsBtn} <Arrow /></a>
    </div>
    <div class="grid">
      {groups.map((g) => (
        <a class="card" href={`${path(lang, 'skills')}#${g}`}>
          <h3 class="card__title">{GROUPS[g][lang]}</h3>
          <code class="list" set:html={SKILLS.filter((s) => s.group === g).map((s) => s.name).join('<br>')} />
        </a>
      ))}
      <a class="card card--accent" href={`${path(lang, 'skills')}#found`}>
        <h3 class="card__title">{GROUPS.found[lang]}</h3>
        <code class="list">projects</code>
        <p class="card__text">{C.foundation}</p>
      </a>
    </div>
  </section>

  <!-- 10. RULES -->
  <section class="band" aria-labelledby="rules-h">
    <div class="wrap section">
      <div class="head-row">
        <h2 id="rules-h" class="h2 h2--sm" style="max-width: 640px;">{C.rulesH}</h2>
        <a class="more" href={path(lang, 'principles')}>{C.rulesMore} <Arrow /></a>
      </div>
      <div class="grid grid--seams">
        {C.rules.map(([tag, title, text]) => (
          <div class="card card--flat"><span class="card__tag">{tag}</span><h3 class="card__title" style="font-size: 19px;">{title}</h3><p class="card__text">{text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- 11. LIMITS -->
  <section class="wrap section" aria-labelledby="limits-h">
    <div class="head-row">
      <div class="stack" style="gap: 12px; max-width: 660px;">
        <p class="eyebrow">{C.limitsEyebrow}</p>
        <h2 id="limits-h" class="h2 h2--sm">{C.limitsH}</h2>
      </div>
      <p class="muted" style="margin: 0; max-width: 400px; line-height: 1.6;">{C.limitsP}</p>
    </div>
    <div class="grid grid--seams" style="--min: 200px;">
      {C.limits.map(([title, text]) => (
        <div class="card card--flat"><h3 class="card__title" style="font-size: 19px;">{title}</h3><p class="card__text">{text}</p></div>
      ))}
    </div>
  </section>

  <!-- 12. AUTHOR -->
  <section class="band" aria-labelledby="author-h">
    <div class="wrap section--tight">
      <div class="stack" style="max-width: 760px;">
        <p class="eyebrow">{C.authorEyebrow}</p>
        <h2 id="author-h" class="h2 h2--sm">{C.authorH}</h2>
        <p class="muted" style="margin: 0; font-size: 18px; line-height: 1.65;">{C.authorP}</p>
      </div>
    </div>
  </section>

  <!-- 13. START -->
  <section id="start" aria-labelledby="start-h" style="border-top: 1px solid var(--line); background: var(--surface);">
    <div class="wrap section split" style="align-items: flex-start;">
      <div class="stack" style="flex-basis: 360px;">
        <p class="eyebrow">{C.startEyebrow}</p>
        <h2 id="start-h" class="h2">{C.startH}</h2>
        <p class="muted" style="margin: 0; line-height: 1.65;">{C.startP}</p>
        <div class="btns"><a class="btn btn--primary" href={path(lang, 'start')}>{C.startBtn} <Arrow /></a></div>
      </div>
      <ol class="steps" style="flex-basis: 560px;">
        {C.steps.map(([title, text, prompt]) => (
          <li><div style="min-width: 0; flex: 1;"><b>{title}</b>{text && <p>{text}</p>}{prompt && <code class="prompt">{prompt}</code>}</div></li>
        ))}
      </ol>
    </div>
  </section>
</Base>
