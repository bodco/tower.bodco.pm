  startP: 'Оберіть, як далеко йти. Можна зупинитись на будь-якому поверсі, і зроблене далі працює. Окупається з 2-го тижня, коли підготовки й синки вже роблять роботу самі.',
  startBtn: 'Розгорнути крок за кроком',
  floors: [
    ['Поверх 1 · 10 хв', 'Лише шаблон Notion', 'Дублюєте і користуєтесь руками. Жодного AI.'],
    ['Поверх 2 · вечір · основа', 'Claude плюс Notion', 'Claude вивчає ваш перший проєкт і готує до синків, коли попросите. Перевірено на Маку з Claude Max. Для старту може вистачити Claude Pro.'],
    ['Поверх 3 · коли забракне', 'Доповнення по одному', 'Slack, пошта, Jira, розклад, підказки на дзвінку.'],
  ],
},
}[lang];

const sayOf = (name: string) => SKILLS.find((s) => s.name === name)?.say[lang] ?? name;
---
<Base>
  <!-- 1. HERO: what changes for you -->
  <section class="wrap hero">
    <div class="split split--top">
      <div class="stack" style="gap: 28px; flex-basis: 520px;">
        <p class="eyebrow eyebrow--muted">{C.eyebrow}</p>
        <h1 class="h1 h1--hero">{C.h1}</h1>
        <p class="lead" style="font-size: 19px; max-width: 580px;" set:html={C.lead.replace('<sup>*</sup>', '<a class="fn" href="#fn-schedule" aria-label="footnote">*</a>')}></p>
        <div class="stack" style="gap: 14px;">
          <div class="btns">
            <a class="btn btn--primary" href={path(lang, 'start')}>{t(lang, 'cta.setup')} <Arrow /></a>
            <a class="btn btn--ink" href={LINKS.notion}><NotionLogo /> {t(lang, 'cta.notion.hero')}</a>
            <a class="btn btn--ink" href={LINKS.repo}><GithubLogo /> {t(lang, 'cta.repo.hero')}</a>
          </div>
          <a class="newlink" href={path(lang, 'live-tips')}><span class="newlink__tag">{lang === 'uk' ? 'Нове' : 'New'}</span><LiveTipsLogo /><b>Live Tips</b><span class="newlink__txt">{lang === 'uk' ? 'тихий співпілот на ваших дзвінках, застосунок для Мака' : 'a quiet co-pilot on your calls, an app for Mac'}</span><Arrow /></a>
          <p class="reality">{C.reality}</p>
          <p class="smallprint" id="fn-schedule">{C.fn} <a href={path(lang, 'autopilot')}>{C.fnLink}</a></p>
        </div>
        <ul class="chips chips--plain">{C.chips.map((c) => <li>{c}</li>)}</ul>
      </div>
      <div style="min-width: 0;"><HeroVisual lang={lang} /></div>
    </div>
  </section>

  <!-- 2. BEFORE AND AFTER -->
  <section class="band" aria-labelledby="week-h">
    <div class="wrap section">
      <div class="head-row">
        <h2 id="week-h" class="h2" style="max-width: 760px;">{C.weekH}</h2>
        <a class="more" href={path(lang, 'day')}>{C.weekMore} <Arrow /></a>
      </div>
      <div class="ba">
        <div class="stack stack--sm">
          <p class="label">{C.beforeLabel}</p>
          <div class="grid grid--seams ba__stats">
            {C.problem.map(([n, s]) => <div class="stat"><b>{n}</b><span>{s}</span></div>)}
          </div>
          <p class="muted ba__note">{C.problemP}</p>
        </div>
        <div class="stack stack--sm">
          <p class="label label--accent">{C.afterLabel}</p>
          <ol class="after">
            {C.day.map(([when, title, text]) => <li><code>{when}</code><div><b>{title}</b><span>{text}</span></div></li>)}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. TIME BACK -->
  <section class="wrap section split" style="align-items: flex-start;" aria-labelledby="time-h">
    <div class="stack" style="flex-basis: 340px;">
      <p class="eyebrow">{C.timeEyebrow}</p>
      <h2 id="time-h" class="h2 h2--sm">{C.timeH}</h2>
      <p class="muted" style="margin: 0; line-height: 1.65;">{C.timeP}</p>
    </div>
    <div class="table-box" style="flex-basis: 560px;">
      <table class="table">
        <thead><tr>{C.timeCols.map((c, i) => <th scope="col" style={i === 3 ? 'width: 34%' : undefined}>{c}</th>)}</tr></thead>
        <tbody>
          {C.time.map(([task, before, after, pct]) => (
            <tr><td>{task}</td><td class="muted">{before}</td><td>{after}</td><td><div class="bar"><span style={`width:${pct}%`}></span><code>{pct}%</code></div></td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- 4. ON THE CALL -->
  <section class="band" aria-labelledby="live-h">
    <div class="wrap section split">
      <div class="card" style="padding: 0; gap: 0;">
        <div class="label" style="display: flex; align-items: center; gap: 10px; padding: 14px 18px; border-bottom: 1px solid var(--line-strong); letter-spacing: 0.06em;"><span style="width: 8px; height: 8px; border-radius: 50%; background: var(--accent);" aria-hidden="true"></span>{C.liveHead}</div>
        <div style="padding: 22px 20px; display: flex; flex-direction: column; gap: 12px; font-size: 14.5px; line-height: 1.55;" class="muted">
          <p style="margin: 0;"><b style="color: var(--text); font-weight: 500;">{C.liveClient}:</b> <span lang="en">{C.liveL1}</span></p>
          <p style="margin: 0;"><b style="color: var(--text); font-weight: 500;">{C.liveYou}:</b> <span lang="en">{C.liveL2}</span></p>
        </div>
        <div class="tip" style="margin: 0 20px 22px;">
          <span class="card__tag" style="font-size: 11px;">{C.liveTag}</span>
          <b>{C.liveGist}</b>
          <span lang="en">{C.livePhrase}</span>
        </div>
      </div>
      <div class="stack">
        <p class="eyebrow">{C.liveEyebrow}</p>
        <h2 id="live-h" class="h2">{C.liveH}</h2>
        <p class="muted" style="margin: 0; font-size: 17px; line-height: 1.65;">{C.liveP}</p>
        <div class="btns">
          <a class="btn btn--primary" href="https://github.com/bodco/live-tips/releases/latest/download/LiveTips.dmg" download>{lang === 'uk' ? 'Завантажити для Мака' : 'Download for Mac'}</a>
          <a class="more" href={path(lang, 'live-tips')}>{C.liveMore} <Arrow /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. ASK LIKE A COLLEAGUE -->
  <section class="wrap section" aria-labelledby="skills-h">
    <div class="head-row">
      <div class="stack" style="gap: 16px; max-width: 680px;">
        <p class="eyebrow">{C.skillsEyebrow}</p>
        <h2 id="skills-h" class="h2 h2--sm">{C.skillsH}</h2>
        <p class="muted" style="margin: 0; font-size: 17px; line-height: 1.6;">{C.skillsP}</p>
      </div>
      <a class="btn" href={path(lang, 'skills')}>{C.skillsBtn} <Arrow /></a>
    </div>
    <ul class="grid says" style="--min: 240px;">
      {C.says.map(([name, outcome]) => (
        <li class="card say">
          <span class="label">{C.say}</span>
          <b class="say__q">"{sayOf(name)}"</b>
          <p class="card__text">{outcome}</p>
        </li>
      ))}
    </ul>
    <p class="how-line muted">{C.howQ} <a class="more" href={path(lang, 'how-it-works')}>{C.howLink} <Arrow /></a></p>
  </section>

  <!-- 6. NOTION, COMPACT -->
  <section class="band" aria-labelledby="notion-h">
    <div class="wrap section split">
      <div class="stack" style="gap: 18px; flex-basis: 380px;">
        <p class="eyebrow">{C.notionEyebrow}</p>
        <h2 id="notion-h" class="h2 h2--sm">{C.notionH}</h2>
        <p class="muted" style="margin: 0; font-size: 17px; line-height: 1.6;">{C.notionP}</p>
        <div class="btns"><a class="btn" href={path(lang, 'notion')}>{C.notionTour} <Arrow /></a></div>
      </div>
      <div style="min-width: 0; flex-basis: 560px;"><FocusVisual lang={lang} /></div>
    </div>
  </section>

  <!-- 6b. REAL SCREENSHOTS -->
  <section class="wrap section" aria-labelledby="shots-h">
    <div class="head-row">
      <div class="stack" style="gap: 14px; max-width: 680px;">
        <h2 id="shots-h" class="h2 h2--sm">{C.shotsH}</h2>
        <p class="muted" style="margin: 0; font-size: 17px; line-height: 1.6;">{C.shotsP}</p>
      </div>
      <a class="btn btn--ink" href={LINKS.notion}><NotionLogo /> {C.shotsLink}</a>
    </div>
    <div class="shots">
      {C.shots.map(([src, w, h, bar, title, text]) => (
        <figure class="shot">
          <div class="shot__bar" aria-hidden="true"><i></i><i></i><i></i><span>{bar}</span></div>
          <div class="shot__img"><img src={`/${src}`} width={w} height={h} loading="lazy" decoding="async" alt={`${title}: ${text}`} /></div>
          <figcaption><b>{title}</b> {text}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- 7. TRUST: rules, limits, practical answers -->
  <section class="wrap section" aria-labelledby="trust-h">
    <div class="head-row">
      <div class="stack" style="gap: 14px; max-width: 720px;">
        <p class="eyebrow">{C.trustEyebrow}</p>
        <h2 id="trust-h" class="h2">{C.trustH}</h2>
      </div>
      <p class="muted" style="margin: 0; max-width: 400px; line-height: 1.6;">{C.trustP}</p>
    </div>
    <div class="trust__group">
      <div class="trust__label"><span class="label">{C.rulesLabel}</span><a class="more" href={path(lang, 'principles')}>{C.rulesMore} <Arrow /></a></div>
      <ol class="grid grid--seams trust__grid" style="--min: 230px;">
        {C.rules.map(([title, text], i) => (
          <li class="card card--flat tcard"><span class="card__tag">{i + 1}</span><h3 class="card__title">{title}</h3><p class="card__text">{text}</p></li>
        ))}
      </ol>
    </div>
    <div class="trust__group">
      <div class="trust__label"><span class="label">{C.limitsLabel}</span></div>
      <ul class="grid grid--seams trust__grid" style="--min: 250px;">
        {C.limits.map(([title, text, href, label]) => (
          <li class="card card--flat tcard"><h3 class="card__title">{title}</h3><p class="card__text">{text}</p>{href && <a class="tlink" href={href}>{label} <Arrow /></a>}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 8. AUTHOR -->
  <section class="band" aria-labelledby="author-h">
    <div class="wrap section--tight">
      <div class="stack" style="max-width: 760px;">
        <p class="eyebrow">{C.authorEyebrow}</p>
        <h2 id="author-h" class="h2 h2--sm">{C.authorH}</h2>
        <p class="muted" style="margin: 0; font-size: 18px; line-height: 1.65;">{C.authorP}</p>
        <div class="author-links">
          <a class="more" href={LINKS.author(lang)}>{C.authorCv} <Arrow /></a>
          <a class="more" href={LINKS.github}><GithubLogo /> {C.authorLink} <Arrow /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- 9. START: 3 floors -->
  <section id="start" aria-labelledby="start-h" style="border-top: 1px solid var(--line); background: var(--surface);">
    <div class="wrap section">
      <div class="head-row">
        <div class="stack" style="gap: 16px; max-width: 680px;">
          <p class="eyebrow">{C.startEyebrow}</p>
          <h2 id="start-h" class="h2">{C.startH}</h2>
          <p class="muted" style="margin: 0; font-size: 17px; line-height: 1.6;">{C.startP}</p>
        </div>
        <a class="btn" href={path(lang, 'start')}>{C.startBtn} <Arrow /></a>
      </div>
      <ol class="levels floors">
        {C.floors.map(([n, title, text], i) => (
          <li class={`level ${i === 1 ? 'level--must' : ''}`}>
            <span class="level__n">{n}</span>
            <h3 class="card__title">{title}</h3>
            <p class="card__text">{text}</p>
            {i === 0 && <a class="btn btn--ink floor__cta" href={LINKS.notion}><NotionLogo /> {t(lang, 'cta.notion.short')}</a>}
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: 88px; padding-bottom: 88px; }
  @media (max-width: 720px) { .hero { padding-top: 56px; padding-bottom: 64px; } }
  .reality { margin: 0; font-size: 14px; line-height: 1.55; color: var(--text-3); max-width: 560px; }
  .chips--plain li { font-family: var(--sans); font-size: 14px; letter-spacing: 0; text-transform: none; padding: 7px 12px; }

  .label--accent { color: var(--accent); }
  .ba { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 56px; align-items: start; }
  @media (max-width: 900px) { .ba { grid-template-columns: minmax(0, 1fr); gap: 44px; } }
  .ba__stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .ba__stats .stat { padding: 20px; }
  .ba__stats .stat b { font-size: 36px; }
  .ba__stats .stat span { font-size: 14.5px; line-height: 1.45; }
  .ba__note { margin: 4px 0 0; font-size: 15px; line-height: 1.6; }
  @media (max-width: 360px) { .ba__stats .stat { padding: 16px 14px; } .ba__stats .stat b { font-size: 30px; } }

  .after { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--accent); }
  .after li { display: grid; grid-template-columns: 170px minmax(0, 1fr); gap: 6px 20px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .after code { font-size: 13px; color: var(--text-3); padding-top: 3px; }
  .after li:first-child code { color: var(--accent); }
  .after div { display: flex; flex-direction: column; gap: 4px; }
  .after b { font-size: 17px; font-weight: 600; }
  .after span { color: var(--text-2); font-size: 15px; line-height: 1.55; }
  @media (max-width: 560px) { .after li { grid-template-columns: minmax(0, 1fr); } }

  .says { list-style: none; margin: 0; padding: 0; }
  .say { gap: 10px; }
  .say__q { font-size: 18px; font-weight: 600; line-height: 1.35; }
  .how-line { margin: 24px 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: 0 12px; font-size: 16px; }

  .notion-row { display: flex; flex-wrap: wrap; gap: 24px 48px; align-items: end; justify-content: space-between; }

  .trust__group + .trust__group { margin-top: 40px; }
  .trust__label { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0 24px; margin-bottom: 12px; min-height: 44px; }
  .trust__grid { list-style: none; margin: 0; padding: 0; }
  .tcard { padding: 22px 24px; gap: 8px; }
  .tcard .card__title { font-size: 17px; }
  .tcard .card__text { font-size: 14.5px; line-height: 1.55; }
  .tlink { margin-top: auto; padding: 10px 0 4px; display: block; min-height: 44px; line-height: 1.5; color: var(--accent); font-size: 14.5px; font-weight: 500; text-decoration: underline; text-underline-offset: 3px; }
  .tlink:hover { color: var(--accent-hover); }
  .tlink :global(svg) { display: inline; vertical-align: -2px; margin-left: 4px; }

  .author-links { display: flex; flex-wrap: wrap; gap: 0 32px; }
  .floors { list-style: none; padding: 0; margin-top: 0; }
  .floor__cta { margin-top: auto; align-self: flex-start; }
</style>