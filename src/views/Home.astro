---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import NotionLogo from '../components/NotionLogo.astro';
import GithubLogo from '../components/GithubLogo.astro';
import HeroVisual from '../components/HeroVisual.astro';
import { LINKS, VERSION, path, t, type Lang } from '../i18n/ui';
import { SKILLS, GROUPS } from '../data/skills';

interface Props { lang: Lang }
const { lang } = Astro.props;

const C = {
  en: {
  // 1. HERO
  eyebrow: 'Open-source AI setup for project managers',
  h1: 'Your meeting prep and reply drafts, ready before the day starts',
  lead: 'Early each morning it reads your chats, mail, meetings and tracker. By 09:00 you have a report on yesterday and a draft for every message waiting on you. Each meeting prep arrives about 55 minutes before the call. You read, fix and send. Nothing goes to the client without you.',
  chips: ['Free Notion template', 'Drafts only, you press send', 'Beta, used daily by its author', `MIT · v${VERSION}`],

  // 2. BEFORE
  problemH: 'Where the week of a delivery PM actually goes',
  problemP: 'Numbers from the project this grew up on, before any automation. The real cost was not the hours. It was living in reaction mode, with no time left to think about risks or the client.',
  problem: [
    ['5+', 'chat channels to scroll every day, so nothing slips'],
    ['3-4', 'client meetings a week, each to prepare and write up'],
    ['50+', 'tickets to label, estimate and chase'],
    ['2h+', 'a week spent only on weekly and monthly reports'],
  ],

