  dayEyebrow: 'After',
  dayH: 'What the same day looks like now',
  dayMore: 'Day, week and month in full',
  day: [
    ['Before 09:00', 'It runs without you', 'Chats and mail from yesterday are sorted by whose turn it is to answer. A daily report and reply drafts are waiting.'],
    ['09:00 · 15-30 min', 'You read instead of digging', 'Read the report. Send, edit or park each draft. Pick 3 things for today.'],
    ['Before each meeting', 'The prep is already there', 'About 55 minutes before the call: board movement, blockers, open questions, errors from the last 24 hours. You add your own notes.'],
    ['During the day', 'Your head is free for decisions', 'Replies in 2-3 batches instead of all day long. A decision goes into the log as a sentence. A "small extra" from the client gets sorted before you agree to it.'],
    ['End of day · 5 min', 'Close and leave', 'Mark what is done, empty the inbox, write a line about tomorrow. The analysis waits for the morning report.'],
  ],

  // 4. TIME BACK
  timeEyebrow: 'Time back',
  timeH: 'About a full working day a week, back',
  timeP: 'Before and after, estimated on the author\'s own project in April 2026. Your numbers will depend on your tools and on how well your project file is filled in, so measure them on your own project.',
  timeCols: ['Task', 'Before', 'After', 'Saved'],
  time: [
    ['Prep for the daily sync', '30 min', '3 min', 90],
    ['Writing up a meeting', '45 min', '5 min', 89],
    ['Weekly scan of the chats', '2 h', '10 min', 92],
    ['Monthly client report', '4 h', '30 min', 88],
    ['Cleaning up the board', '1 h', '5 min', 92],
    ['Error and log scan, 7 services', '~2 days', '~15 min', 99],
  ],

  // 5. ON THE CALL
