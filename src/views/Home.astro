import GithubLogo from '../components/GithubLogo.astro';
import LiveTipsLogo from '../components/LiveTipsLogo.astro';
import HeroVisual from '../components/HeroVisual.astro';
import FocusVisual from '../components/FocusVisual.astro';
import { LINKS, path, t, type Lang } from '../i18n/ui';
import { SKILLS } from '../data/skills';

interface Props { lang: Lang }
const { lang } = Astro.props;

const PRICE_URL = 'https://claude.com/pricing';
const PRIVACY_URL = 'https://www.anthropic.com/legal/privacy';

const C = {
  en: {
  // 1. HERO
  eyebrow: 'Open-source Claude setup for project managers',
  h1: 'Your meeting prep and reply drafts, ready before the day starts',
