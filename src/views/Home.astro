  dbs: [
    ['Inbox', 'drop it now, sort it later'],
    ['Tasks Tracker', 'your tasks from every project, in a single list'],
    ['Meetings', 'transcript, summary, action items'],
    ['Threads', 'who owes whom a reply'],
    ['Topics', 'subjects that run for weeks'],
    ['Knowledge Base', 'how things work, where things are'],
    ['Risks', 'risks, assumptions, issues, dependencies'],
    ['Decisions', 'a sentence, a date, a source'],
