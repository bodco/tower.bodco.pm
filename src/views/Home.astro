  weekH: 'Your week before, and the same day after',
  weekMore: 'Day, week and month in full',
  beforeLabel: 'Before · a typical week',
  afterLabel: 'After · the same day',
  problemP: 'Numbers from the project this grew up on, before any automation. Context was spread across chats, inboxes, transcripts and people\'s heads, so every decision meant digging it all up again.',
  problem: [
    ['5+', 'chat channels to scroll every day, so nothing slips'],
    ['3-4', 'client meetings a week, each to prepare and write up'],
    ['50+', 'tickets to label, estimate and chase'],
    ['2h+', 'a week spent only on weekly and monthly reports'],
  ],
  day: [
    ['Before 09:00', 'It runs without you', 'Yesterday\'s chats and mail are sorted by whose turn it is to answer. Reply drafts are waiting.'],
    ['09:00 · 15-30 min', 'You read what came in', 'Go through the threads that wait on you. Send, edit or park each draft. Pick 3 things for today.'],
