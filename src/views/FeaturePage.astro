---
import { getEntry, render } from 'astro:content';
import Feature from '../layouts/Feature.astro';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const entry = await getEntry('pages', `${lang}/${slug}`);
if (!entry) throw new Error(`Missing content: ${lang}/${slug}`);
const { Content, headings } = await render(entry);
const d = entry.data;
---
<Feature lang={lang} slug={slug} title={d.title} lead={d.lead} description={d.description} facts={d.facts} doc={d.doc} headings={headings}>
  <Content />
</Feature>
